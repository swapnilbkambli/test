#!/usr/bin/env bash
# =============================================================================
#  patch_checks.sh  –  Comprehensive Linux Server Patching Pre/Post Checks
#  Version : 3.0
#  Author  : Infrastructure / Patch Management Team
# =============================================================================
#
#  USAGE
#  ─────
#    sudo bash patch_checks.sh pre      ← run BEFORE applying patches
#    sudo bash patch_checks.sh post     ← run AFTER  applying patches
#    sudo bash patch_checks.sh compare  ← generate diff / change report
#
#  FULL MONTHLY CYCLE
#  ──────────────────
#    1. sudo bash patch_checks.sh pre
#    2. Apply patches  (yum update / apt upgrade / etc.)
#    3. sudo bash patch_checks.sh post
#    4. sudo bash patch_checks.sh compare
#
#  REPORT LAYOUT  (/var/log/patch_checks/)
#  ────────────────────────────────────────
#    pre/   PRE_PATCH_<host>_YYYYMMDD.txt
#    post/  POST_PATCH_<host>_YYYYMMDD.txt
#    diff/  COMPARISON_<host>_YYYYMMDD_HHMMSS.txt
#    LATEST_PRE_<host>.txt        → symlink → newest pre  report
#    LATEST_POST_<host>.txt       → symlink → newest post report
#    LATEST_COMPARISON_<host>.txt → symlink → newest diff report
#
#  RETENTION
#  ─────────
#    Reports older than 180 days (6 months) are auto-purged on every run.
#    Change RETENTION_DAYS in the Configuration block below to adjust.
#
# =============================================================================
#  SAFETY GUARANTEE — THIS SCRIPT IS 100% READ-ONLY
# =============================================================================
#
#  Every command in this script is a passive data-reader. The script:
#
#    ✔  ONLY reads files, queries system state, and writes to its own
#       report files under /var/log/patch_checks/
#
#    ✘  NEVER invokes:  logrotate, service restart/start/stop/reload,
#                       systemctl start/stop/restart/enable/disable,
#                       kill / pkill / killall,
#                       touch / chmod / chown,
#                       apt/yum/dnf install/remove,
#                       any command that modifies system state
#
#  The only files this script ever writes to are:
#    • /var/log/patch_checks/pre/PRE_PATCH_<host>_<date>.txt
#    • /var/log/patch_checks/post/POST_PATCH_<host>_<date>.txt
#    • /var/log/patch_checks/diff/COMPARISON_<host>_<datetime>.txt
#    • /var/log/patch_checks/LATEST_*.txt  (symlinks only)
#    • /tmp/_*.txt  (short-lived diff scratch files, deleted immediately)
#
#  Commands used and what they do:
#    rpm -qa | grep SCBrel — queries RPM DB read-only, no install/remove
#    cat, grep, awk, sed, sort, find  — read and filter file content
#    df, du, lsblk, mount             — read filesystem/disk state
#    ip, ss, iptables -L, ufw status  — read network state (no changes)
#    systemctl list-*                 — list only, never start/stop/enable
#    service --status-all             — read-only status listing (SysV fallback)
#    journalctl, dmesg                — read kernel/systemd logs
#    rpm -qa, rpm -V                  — query package database (no install)
#    dpkg -l                          — list packages (no install)
#    sha256sum                        — compute checksums (reads files only)
#    sysctl -a                        — read kernel parameters (no -w write)
#    ps, top, lscpu, lsmod            — read process/hardware state
#    free, uptime, who, last          — read memory/session state
#    timedatectl, chronyc, ntpq       — read time sync status (no set)
#    getenforce, sestatus, aa-status  — read SELinux/AppArmor state
#    pcs status, crm status           — read cluster state (no modify)
#    docker ps / images               — read container state (no run/stop)
#    logrotate STATE file read via cat — logrotate binary is NEVER called
#
# =============================================================================
#  WHAT THIS SCRIPT CHECKS  (PRE and POST snapshots)
# =============================================================================
#
#  ┌─────────────────────────────────────────────────────────────────────────┐
#  │  #   CATEGORY              ITEMS COLLECTED                              │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  1   PATCH LEVEL           rpm -qa | grep SCBrel  — site patch marker   │
#  │                            printed on screen AND written to report      │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  2   SYSTEM INFO           hostname, OS release, kernel version,        │
#  │                            uptime, last boot time, current sessions      │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  3   INSTALLED PACKAGES    full package list (RPM / DEB),               │
#  │                            snap packages, flatpak packages               │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  4   KERNEL MODULES        all currently loaded modules (lsmod)          │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  5   SERVICES              running systemd units,                        │
#  │                            failed systemd units,                         │
#  │                            enabled unit files                            │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  6   NETWORK               IP addresses & interfaces,                    │
#  │                            routing table,                                │
#  │                            listening TCP/UDP ports (ss / netstat),       │
#  │                            DNS (/etc/resolv.conf),                       │
#  │                            /etc/hosts,                                   │
#  │                            iptables rules,                               │
#  │                            firewalld zones (if present),                 │
#  │                            ufw status (if present)                       │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  7   DISK                  df -hT (filesystem usage + type),             │
#  │                            df -i  (inode usage),                         │
#  │                            lsblk  (block devices, UUIDs, mount points),  │
#  │                            LVM volume groups & logical volumes,          │
#  │                            /etc/fstab (active mount config),             │
#  │                            mount   (currently mounted filesystems)       │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  8   MEMORY & SWAP         free -h, /proc/meminfo,                       │
#  │                            swap partitions (swapon --show)               │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  9   CPU & LOAD            lscpu (CPU topology, cores, speed),           │
#  │                            /proc/loadavg, top snapshot                   │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  10  SECURITY              SELinux mode & policy (getenforce/sestatus),  │
#  │                            AppArmor status (aa-status),                  │
#  │                            /etc/sudoers (non-comment lines),             │
#  │                            /etc/ssh/sshd_config (non-comment lines),     │
#  │                            last 20 login sessions,                       │
#  │                            /etc/passwd users with login shells           │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  11  SCHEDULED JOBS        /etc/crontab, /etc/cron.d/*,                  │
#  │                            /var/spool/cron/crontabs/*,                   │
#  │                            systemd timers (all),                         │
#  │                            at jobs (atq)                                 │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  12  KERNEL PARAMETERS     full sysctl -a output (sorted),               │
#  │                            /proc/cmdline (boot parameters),              │
#  │                            available kernels in /boot,                   │
#  │                            default kernel (grubby)                       │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  13  REPOSITORIES          yum / dnf repolist (all),                     │
#  │                            /etc/apt/sources.list,                        │
#  │                            /etc/apt/sources.list.d/*                     │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  14  RUNNING PROCESSES     full ps auxf process tree                     │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  15  SYSTEM LOGS           journald  : emerg/alert/crit/err, last 7d,    │
#  │                            dmesg     : err/crit/alert/emerg (no ts),     │
#  │                            syslog    : /var/log/messages or syslog,      │
#  │                            kernel    : /var/log/kern.log,                │
#  │                            auth      : /var/log/auth.log or secure,      │
#  │                            audit     : /var/log/audit/audit.log,         │
#  │                            failed systemd units at snapshot time         │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  16  LOG ROTATION          /etc/logrotate.conf (read-only),              │
#  │                            /etc/logrotate.d/* (read-only),               │
#  │                            logrotate state file (read-only cat),         │
#  │                            /var/log directory sizes (du -sh),            │
#  │                            largest log files top 20,                     │
#  │                            compressed archive counts,                    │
#  │                            /etc/systemd/journald.conf (read-only),       │
#  │                            journalctl --disk-usage                       │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  17  RPM VERIFY            rpm -V on: bash, sudo, openssh-server,        │
#  │                            glibc, kernel  (detects tampered binaries)    │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  18  FILE INTEGRITY        SHA-256 checksums of:                         │
#  │                            /etc/passwd, /etc/shadow, /etc/group,         │
#  │                            /etc/sudoers, /etc/ssh/sshd_config,           │
#  │                            /etc/hosts, /etc/fstab,                       │
#  │                            /etc/resolv.conf, /etc/nsswitch.conf          │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  19  TIME / NTP            timedatectl status,                           │
#  │                            chronyc tracking + sources (if chrony),       │
#  │                            ntpq -p (if ntpd)                             │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  20  HA / CLUSTER          pcs status (if Pacemaker/Corosync),           │
#  │                            crm status (if crm tools present)             │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  21  CONTAINERS            docker version, docker ps, docker images,     │
#  │                            podman ps (if podman present)                 │
#  └─────────────────────────────────────────────────────────────────────────┘
#
# =============================================================================
#  WHAT THE COMPARISON REPORT DIFFS
# =============================================================================
#
#  ┌─────────────────────────────────────────────────────────────────────────┐
#  │  SECTION                   WHAT IS COMPARED                             │
#  ├─────────────────────────────────────────────────────────────────────────┤
#  │  Patch level (SCBrel)      PRE vs POST value shown on screen AND in     │
#  │                            report; CHANGED / UNCHANGED status flagged   │
#  │  Kernel version            PRE kernel vs POST kernel                    │
#  │  Packages                  newly installed, removed, updated            │
#  │  Services                  started, stopped, enable/disable changes     │
#  │  Listening ports           new ports opened, existing ports closed      │
#  │  Disk usage                per-filesystem usage delta                   │
#  │  Kernel modules            modules loaded / unloaded after patch        │
#  │  File integrity            SHA-256 checksum changes on key config files │
#  │  Log rotation              logrotate config changes, state file delta,  │
#  │                            journald disk usage change                   │
#  │  Log errors (new/cleared)  NEW errors in journald/dmesg/syslog/auth/   │
#  │                            audit/kern that were not present before;     │
#  │                            also shows errors that CLEARED after patch   │
#  │  Full raw diff             complete line-by-line diff of PRE vs POST    │
#  └─────────────────────────────────────────────────────────────────────────┘
#
# =============================================================================

set -euo pipefail

# ── Configuration ─────────────────────────────────────────────────────────────
REPORT_DIR="/var/log/patch_checks"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
DATESTAMP=$(date +"%Y%m%d")
HOSTNAME=$(hostname -f 2>/dev/null || hostname)
MODE="${1:-}"

# Retention: reports older than this many days are purged (6 months = 180 days)
RETENTION_DAYS=180

PRE_DIR="${REPORT_DIR}/pre"
POST_DIR="${REPORT_DIR}/post"
DIFF_DIR="${REPORT_DIR}/diff"

# Dated filenames — one file per patch cycle per day
PRE_REPORT="${PRE_DIR}/PRE_PATCH_${HOSTNAME}_${DATESTAMP}.txt"
POST_REPORT="${POST_DIR}/POST_PATCH_${HOSTNAME}_${DATESTAMP}.txt"
COMPARE_REPORT="${DIFF_DIR}/COMPARISON_${HOSTNAME}_${TIMESTAMP}.txt"

# Symlinks always pointing to the latest report of each type
PRE_LATEST="${REPORT_DIR}/LATEST_PRE_${HOSTNAME}.txt"
POST_LATEST="${REPORT_DIR}/LATEST_POST_${HOSTNAME}.txt"
COMPARE_LATEST="${REPORT_DIR}/LATEST_COMPARISON_${HOSTNAME}.txt"

# ── Colours ───────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
  CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; RESET=''
fi

# ── Helpers ───────────────────────────────────────────────────────────────────
log()     { echo -e "${CYAN}[$(date '+%H:%M:%S')]${RESET} $*"; }
success() { echo -e "${GREEN}[✔]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[!]${RESET} $*"; }
error()   { echo -e "${RED}[✘]${RESET} $*" >&2; }
header()  { echo -e "\n${BOLD}${CYAN}══════════════════════════════════════════${RESET}";
            echo -e "${BOLD}${CYAN}  $*${RESET}";
            echo -e "${BOLD}${CYAN}══════════════════════════════════════════${RESET}"; }

section() {
  local title="$1" file="$2"
  echo ""            >> "$file"
  echo "########################################" >> "$file"
  echo "# $title"   >> "$file"
  echo "# $(date)"  >> "$file"
  echo "########################################" >> "$file"
}

check_root() {
  if [ "$(id -u)" -ne 0 ]; then
    error "This script must be run as root (use sudo)."
    exit 1
  fi
}

ensure_dirs() {
  mkdir -p "$PRE_DIR" "$POST_DIR" "$DIFF_DIR"
}

cmd_exists() { command -v "$1" >/dev/null 2>&1; }

# ── Retention: delete reports older than RETENTION_DAYS ──────────────────────
purge_old_reports() {
  log "Purging reports older than ${RETENTION_DAYS} days (retention = 6 months)..."
  local count=0
  local old_file

  for subdir in "$PRE_DIR" "$POST_DIR" "$DIFF_DIR"; do
    if [ -d "$subdir" ]; then
      find "$subdir" -maxdepth 1 -type f -name "*.txt" \
           -mtime "+${RETENTION_DAYS}" > /tmp/_old_reports.txt 2>/dev/null || true
      while IFS= read -r old_file; do
        [ -z "$old_file" ] && continue
        rm -f "$old_file"
        count=$((count + 1))
        log "  Removed: $old_file"
      done < /tmp/_old_reports.txt
      rm -f /tmp/_old_reports.txt
    fi
  done

  if [ "$count" -eq 0 ]; then
    success "No old reports to purge."
  else
    success "Purged ${count} report(s) older than ${RETENTION_DAYS} days."
  fi

  echo ""
  log "Current report inventory (kept within ${RETENTION_DAYS}-day window):"
  printf "  %-6s  %s\n" "COUNT" "DIRECTORY"
  printf "  %-6s  %s\n" "-----" "---------"
  for subdir in "$PRE_DIR" "$POST_DIR" "$DIFF_DIR"; do
    local cnt
    cnt=$(find "$subdir" -maxdepth 1 -type f -name "*.txt" 2>/dev/null | wc -l | tr -d ' ')
    printf "  %-6s  %s\n" "$cnt" "$subdir"
  done
  echo ""
}

# ── Collection Functions ──────────────────────────────────────────────────────

collect_patch_level() {
  # READ-ONLY: rpm -qa queries the RPM database — it never installs or removes.
  # Output is written to the report file AND printed prominently on screen so
  # the engineer can confirm patch level without opening the report.
  local out="$1"
  local mode_label="$2"

  section "PATCH LEVEL (SCBrel)" "$out"

  local scbrel_value
  scbrel_value=$(rpm -qa 2>/dev/null | grep SCBrel || echo "(SCBrel package not found)")

  # Write to report file
  echo "$scbrel_value" >> "$out"

  # Also print on screen with a prominent box
  echo ""
  echo -e "${BOLD}┌─────────────────────────────────────────────────────┐${RESET}"
  echo -e "${BOLD}│  PATCH LEVEL (SCBrel) — ${mode_label}${RESET}"
  echo -e "${BOLD}│  ${CYAN}${scbrel_value}${RESET}"
  echo -e "${BOLD}└─────────────────────────────────────────────────────┘${RESET}"
  echo ""
}

collect_system_info() {
  local out="$1"
  section "SYSTEM INFORMATION" "$out"
  {
    echo "Hostname        : $(hostname -f 2>/dev/null || hostname)"
    echo "Date/Time       : $(date)"
    echo "Uptime          : $(uptime -p 2>/dev/null || uptime)"
    echo "Kernel          : $(uname -r)"
    echo "OS Release      :"
    cat /etc/os-release 2>/dev/null || cat /etc/redhat-release 2>/dev/null || echo "Unknown"
    echo ""
    echo "Last Boot       : $(who -b 2>/dev/null || last reboot 2>/dev/null | head -1)"
    echo "Current Users   :"
    who 2>/dev/null || echo "N/A"
  } >> "$out"
}

collect_packages() {
  local out="$1"
  section "INSTALLED PACKAGES" "$out"
  if cmd_exists rpm; then
    rpm -qa --queryformat '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' 2>/dev/null | sort >> "$out"
  elif cmd_exists dpkg; then
    dpkg -l 2>/dev/null | grep '^ii' | awk '{print $2"\t"$3}' | sort >> "$out"
  else
    echo "No supported package manager found." >> "$out"
  fi

  section "SNAP PACKAGES" "$out"
  if cmd_exists snap; then
    snap list 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  else
    echo "snap not installed" >> "$out"
  fi

  section "FLATPAK PACKAGES" "$out"
  if cmd_exists flatpak; then
    flatpak list 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  else
    echo "flatpak not installed" >> "$out"
  fi
}

collect_kernel_modules() {
  local out="$1"
  section "LOADED KERNEL MODULES" "$out"
  lsmod 2>/dev/null | sort >> "$out" || echo "N/A" >> "$out"
}

collect_services() {
  local out="$1"
  section "SYSTEMD SERVICES (running)" "$out"
  if cmd_exists systemctl; then
    systemctl list-units --type=service --state=running --no-legend 2>/dev/null \
      | awk '{print $1, $2, $3, $4}' | sort >> "$out"
    section "SYSTEMD SERVICES (failed)" "$out"
    systemctl list-units --type=service --state=failed --no-legend 2>/dev/null \
      | awk '{print $1, $2, $3, $4}' | sort >> "$out" || echo "None" >> "$out"
    section "SYSTEMD ENABLED UNITS" "$out"
    systemctl list-unit-files --state=enabled --no-legend 2>/dev/null \
      | awk '{print $1}' | sort >> "$out"
  else
    # SysV fallback — read-only status listing
    service --status-all 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  fi
}

collect_network() {
  local out="$1"
  section "NETWORK INTERFACES" "$out"
  ip -br addr show 2>/dev/null >> "$out" || ifconfig 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "NETWORK ROUTES" "$out"
  ip route show 2>/dev/null >> "$out" || netstat -rn 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "LISTENING PORTS (TCP/UDP)" "$out"
  if cmd_exists ss; then
    ss -tlunp 2>/dev/null >> "$out"
  elif cmd_exists netstat; then
    netstat -tlunp 2>/dev/null >> "$out"
  else
    echo "N/A" >> "$out"
  fi

  section "DNS CONFIGURATION" "$out"
  cat /etc/resolv.conf 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "HOSTS FILE" "$out"
  cat /etc/hosts 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "FIREWALL (iptables)" "$out"
  iptables -L -n --line-numbers 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "FIREWALL (firewalld)" "$out"
  if cmd_exists firewall-cmd; then
    firewall-cmd --list-all 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  else
    echo "firewalld not installed" >> "$out"
  fi

  section "FIREWALL (ufw)" "$out"
  if cmd_exists ufw; then
    ufw status verbose 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  else
    echo "ufw not installed" >> "$out"
  fi
}

collect_disk() {
  local out="$1"
  section "DISK USAGE (df -hT)" "$out"
  df -hT 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "DISK INODES (df -i)" "$out"
  df -i 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "BLOCK DEVICES (lsblk)" "$out"
  lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINT,UUID 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "LVM - VOLUME GROUPS" "$out"
  if cmd_exists vgdisplay; then
    vgdisplay 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  else
    echo "LVM not installed" >> "$out"
  fi

  section "LVM - LOGICAL VOLUMES" "$out"
  if cmd_exists lvdisplay; then
    lvdisplay 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  else
    echo "LVM not installed" >> "$out"
  fi

  section "FSTAB" "$out"
  grep -v '^#' /etc/fstab 2>/dev/null | grep -v '^$' >> "$out" || echo "N/A" >> "$out"

  section "MOUNT POINTS" "$out"
  mount | sort >> "$out" || echo "N/A" >> "$out"
}

collect_memory() {
  local out="$1"
  section "MEMORY AND SWAP" "$out"
  free -h 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  echo "" >> "$out"
  echo "--- /proc/meminfo ---" >> "$out"
  cat /proc/meminfo 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "SWAP PARTITIONS" "$out"
  swapon --show 2>/dev/null >> "$out" || cat /proc/swaps 2>/dev/null >> "$out" || echo "N/A" >> "$out"
}

collect_cpu() {
  local out="$1"
  section "CPU / HARDWARE" "$out"
  lscpu 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "CPU LOAD AVERAGES" "$out"
  cat /proc/loadavg >> "$out" 2>/dev/null || echo "N/A" >> "$out"
  echo "" >> "$out"
  top -bn1 2>/dev/null | head -10 >> "$out" || echo "N/A" >> "$out"
}

collect_security() {
  local out="$1"
  section "SELinux STATUS" "$out"
  if cmd_exists getenforce; then
    getenforce 2>/dev/null >> "$out"
    sestatus 2>/dev/null >> "$out" || true
  else
    echo "SELinux not installed" >> "$out"
  fi

  section "AppArmor STATUS" "$out"
  if cmd_exists aa-status; then
    aa-status 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  else
    echo "AppArmor not installed" >> "$out"
  fi

  section "SUDOERS (non-comment lines)" "$out"
  grep -v '^#' /etc/sudoers 2>/dev/null | grep -v '^$' >> "$out" || echo "N/A" >> "$out"

  section "SSHD CONFIGURATION" "$out"
  if [ -f /etc/ssh/sshd_config ]; then
    grep -v '^#' /etc/ssh/sshd_config 2>/dev/null | grep -v '^$' >> "$out"
  else
    echo "/etc/ssh/sshd_config not found" >> "$out"
  fi

  section "LOGGED-IN USERS AND SESSIONS" "$out"
  last -n 20 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "PASSWD ENTRIES (users with login shells)" "$out"
  grep -v 'nologin\|false' /etc/passwd 2>/dev/null >> "$out" || echo "N/A" >> "$out"
}

collect_scheduled_jobs() {
  local out="$1"
  section "CRON JOBS (system-wide)" "$out"
  for cronfile in /etc/crontab /etc/cron.d/* /var/spool/cron/crontabs/* /var/spool/cron/*; do
    if [ -f "$cronfile" ]; then
      echo "--- $cronfile ---" >> "$out"
      grep -v '^#' "$cronfile" 2>/dev/null | grep -v '^$' >> "$out"
    fi
  done

  section "SYSTEMD TIMERS" "$out"
  if cmd_exists systemctl; then
    systemctl list-timers --all --no-legend 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  fi

  section "AT JOBS" "$out"
  if cmd_exists atq; then
    atq 2>/dev/null >> "$out" || echo "No at jobs" >> "$out"
  else
    echo "at not installed" >> "$out"
  fi
}

collect_kernel_params() {
  local out="$1"
  section "KERNEL PARAMETERS (sysctl)" "$out"
  sysctl -a 2>/dev/null | sort >> "$out" || echo "N/A" >> "$out"

  section "KERNEL CMDLINE" "$out"
  cat /proc/cmdline 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "AVAILABLE KERNELS" "$out"
  if [ -d /boot ]; then
    ls -lh /boot/vmlinuz* /boot/kernel* 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  fi
  if cmd_exists grubby; then
    grubby --default-kernel 2>/dev/null >> "$out" || true
  fi
}

collect_repos() {
  local out="$1"
  section "YUM/DNF REPOSITORIES" "$out"
  if cmd_exists dnf; then
    dnf repolist all 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  elif cmd_exists yum; then
    yum repolist all 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  fi

  section "APT SOURCES" "$out"
  if [ -f /etc/apt/sources.list ]; then
    cat /etc/apt/sources.list 2>/dev/null >> "$out"
  fi
  if [ -d /etc/apt/sources.list.d ]; then
    ls -1 /etc/apt/sources.list.d/ 2>/dev/null | while read -r f; do
      echo "--- /etc/apt/sources.list.d/$f ---" >> "$out"
      grep -v '^#' "/etc/apt/sources.list.d/$f" 2>/dev/null | grep -v '^$' >> "$out"
    done
  fi
}

collect_processes() {
  local out="$1"
  section "RUNNING PROCESSES (full)" "$out"
  ps auxf 2>/dev/null >> "$out" || ps aux 2>/dev/null >> "$out" || echo "N/A" >> "$out"
}

collect_system_logs() {
  local out="$1"

  section "JOURNALD ERRORS (priority: emerg/alert/crit/err)" "$out"
  if cmd_exists journalctl; then
    journalctl -p err --no-pager \
      -o short-iso --since "7 days ago" 2>/dev/null \
      | grep -v '^-- ' \
      | sort >> "$out" \
      || echo "N/A" >> "$out"
  else
    echo "journalctl not available" >> "$out"
  fi

  section "DMESG ERRORS (err/crit/alert/emerg)" "$out"
  dmesg --level=err,crit,alert,emerg --notime 2>/dev/null \
    | sort -u >> "$out" \
    || dmesg 2>/dev/null \
      | grep -iE 'error|fail|critical|warn|oom|panic|oops' \
      | sed 's/^\[[ 0-9.]*\]//' \
      | sort -u >> "$out" \
    || echo "N/A" >> "$out"

  section "SYSLOG ERRORS (/var/log/messages or syslog)" "$out"
  local syslog_file=""
  for f in /var/log/messages /var/log/syslog; do
    [ -r "$f" ] && syslog_file="$f" && break
  done
  if [ -n "$syslog_file" ]; then
    grep -iE ' (error|fail|critical|panic|oom killer|segfault|call trace)' \
      "$syslog_file" 2>/dev/null \
      | tail -200 \
      | awk '{$1=$2=$3=""; print $0}' \
      | sort -u >> "$out" \
      || echo "No matching entries" >> "$out"
  else
    echo "No syslog file found (journald-only system)" >> "$out"
  fi

  section "KERNEL LOG ERRORS (/var/log/kern.log)" "$out"
  if [ -r /var/log/kern.log ]; then
    grep -iE 'error|fail|panic|oops|oom|segfault' /var/log/kern.log 2>/dev/null \
      | tail -100 \
      | awk '{$1=$2=$3=""; print $0}' \
      | sort -u >> "$out" \
      || echo "No matching entries" >> "$out"
  else
    echo "/var/log/kern.log not found" >> "$out"
  fi

  section "AUTH ERRORS (/var/log/auth.log or secure)" "$out"
  local auth_file=""
  for f in /var/log/auth.log /var/log/secure; do
    [ -r "$f" ] && auth_file="$f" && break
  done
  if [ -n "$auth_file" ]; then
    grep -iE 'fail|error|invalid|denied|refused|authentication failure' \
      "$auth_file" 2>/dev/null \
      | tail -100 \
      | awk '{$1=$2=$3=""; print $0}' \
      | sort -u >> "$out" \
      || echo "No matching entries" >> "$out"
  else
    echo "No auth log found" >> "$out"
  fi

  section "AUDIT LOG ERRORS (/var/log/audit/audit.log)" "$out"
  if [ -r /var/log/audit/audit.log ]; then
    grep -E 'type=AVC|type=SYSCALL.*res=failed|type=USER_AUTH.*res=failed' \
      /var/log/audit/audit.log 2>/dev/null \
      | tail -100 >> "$out" \
      || echo "No matching entries" >> "$out"
  else
    echo "/var/log/audit/audit.log not found or not readable" >> "$out"
  fi

  section "FAILED SYSTEMD UNITS (journald)" "$out"
  if cmd_exists systemctl; then
    systemctl list-units --state=failed --no-legend 2>/dev/null \
      | awk '{print $1, $4, $5}' | sort >> "$out" \
      || echo "None" >> "$out"
  fi
}

collect_log_rotation() {
  # READ-ONLY: this function only reads config/state files and queries disk usage.
  # The logrotate binary is NEVER invoked — we only read the config files and
  # the state file that logrotate itself maintains via cron/systemd.
  local out="$1"

  section "LOGROTATE GLOBAL CONFIG (/etc/logrotate.conf)" "$out"
  if [ -f /etc/logrotate.conf ]; then
    grep -v '^#' /etc/logrotate.conf 2>/dev/null | grep -v '^$' >> "$out"
  else
    echo "/etc/logrotate.conf not found" >> "$out"
  fi

  section "LOGROTATE DROP-IN CONFIGS (/etc/logrotate.d/)" "$out"
  if [ -d /etc/logrotate.d ]; then
    for f in /etc/logrotate.d/*; do
      [ -f "$f" ] || continue
      echo "--- $f ---" >> "$out"
      grep -v '^#' "$f" 2>/dev/null | grep -v '^$' >> "$out"
      echo "" >> "$out"
    done
  else
    echo "/etc/logrotate.d not found" >> "$out"
  fi

  # Read-only cat of the state file logrotate maintains — we never run logrotate
  section "LOGROTATE STATE FILE (last rotation timestamps)" "$out"
  local state_file=""
  for f in /var/lib/logrotate/status /var/lib/logrotate.status; do
    [ -f "$f" ] && state_file="$f" && break
  done
  if [ -n "$state_file" ]; then
    echo "State file: $state_file" >> "$out"
    echo "" >> "$out"
    cat "$state_file" 2>/dev/null >> "$out"
  else
    echo "logrotate state file not found" >> "$out"
  fi

  section "LOG DIRECTORY SIZES (/var/log)" "$out"
  du -sh /var/log/* 2>/dev/null | sort -rh | head -30 >> "$out" || echo "N/A" >> "$out"
  echo "" >> "$out"
  echo "Total /var/log usage:" >> "$out"
  du -sh /var/log 2>/dev/null >> "$out" || echo "N/A" >> "$out"

  section "LARGEST LOG FILES (top 20)" "$out"
  find /var/log -type f 2>/dev/null \
    | xargs ls -lh 2>/dev/null \
    | sort -rh -k5 \
    | awk '{print $5, $9}' \
    | head -20 >> "$out" \
    || echo "N/A" >> "$out"

  section "ROTATED LOG ARCHIVE COUNT (/var/log)" "$out"
  {
    echo "  .gz  files : $(find /var/log -type f -name '*.gz'  2>/dev/null | wc -l)"
    echo "  .bz2 files : $(find /var/log -type f -name '*.bz2' 2>/dev/null | wc -l)"
    echo "  .xz  files : $(find /var/log -type f -name '*.xz'  2>/dev/null | wc -l)"
    echo "  .zip files : $(find /var/log -type f -name '*.zip' 2>/dev/null | wc -l)"
    echo "  .1/.2 ..   : $(find /var/log -type f -name '*.[0-9]' 2>/dev/null | wc -l)"
  } >> "$out"

  section "JOURNALD CONFIGURATION (/etc/systemd/journald.conf)" "$out"
  if [ -f /etc/systemd/journald.conf ]; then
    grep -v '^#' /etc/systemd/journald.conf 2>/dev/null | grep -v '^$' >> "$out" \
      || echo "(all defaults — no overrides set)" >> "$out"
  else
    echo "/etc/systemd/journald.conf not found" >> "$out"
  fi
  if [ -d /etc/systemd/journald.conf.d ]; then
    echo "" >> "$out"
    echo "Drop-ins in /etc/systemd/journald.conf.d/:" >> "$out"
    for f in /etc/systemd/journald.conf.d/*.conf; do
      [ -f "$f" ] || continue
      echo "--- $f ---" >> "$out"
      grep -v '^#' "$f" 2>/dev/null | grep -v '^$' >> "$out"
    done
  fi

  section "JOURNALD DISK USAGE" "$out"
  if cmd_exists journalctl; then
    journalctl --disk-usage 2>/dev/null >> "$out" || echo "N/A" >> "$out"
    echo "" >> "$out"
    journalctl --list-boots --no-pager 2>/dev/null | head -10 >> "$out" || true
  else
    echo "journalctl not available" >> "$out"
  fi
}

collect_rpm_checksums() {
  local out="$1"
  section "RPM VERIFY (critical packages)" "$out"
  if cmd_exists rpm; then
    for pkg in bash sudo openssh-server glibc kernel; do
      echo "--- rpm -V $pkg ---" >> "$out"
      rpm -V "$pkg" 2>/dev/null >> "$out" || echo "  (not installed or verify failed)" >> "$out"
    done
  else
    echo "rpm not available" >> "$out"
  fi
}

collect_file_integrity_hints() {
  local out="$1"
  section "KEY CONFIG FILE CHECKSUMS (sha256sum)" "$out"
  for f in /etc/passwd /etc/shadow /etc/group /etc/sudoers \
            /etc/ssh/sshd_config /etc/hosts /etc/fstab \
            /etc/resolv.conf /etc/nsswitch.conf; do
    if [ -f "$f" ]; then
      sha256sum "$f" 2>/dev/null >> "$out"
    fi
  done
}

collect_ntp() {
  local out="$1"
  section "TIME SYNCHRONIZATION" "$out"
  if cmd_exists timedatectl; then
    timedatectl status 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  fi
  if cmd_exists chronyc; then
    echo "--- chronyc tracking ---" >> "$out"
    chronyc tracking 2>/dev/null >> "$out" || echo "N/A" >> "$out"
    echo "--- chronyc sources ---" >> "$out"
    chronyc sources -v 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  elif cmd_exists ntpq; then
    ntpq -p 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  fi
}

collect_ha_cluster() {
  local out="$1"
  section "HA / CLUSTER STATUS" "$out"
  if cmd_exists pcs; then
    pcs status 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  elif cmd_exists crm; then
    crm status 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  else
    echo "No HA cluster tools found (pcs/crm)" >> "$out"
  fi
}

collect_docker() {
  local out="$1"
  section "DOCKER / CONTAINER STATUS" "$out"
  if cmd_exists docker; then
    echo "--- docker version ---" >> "$out"
    docker version 2>/dev/null >> "$out" || echo "N/A" >> "$out"
    echo "--- docker ps (running) ---" >> "$out"
    docker ps 2>/dev/null >> "$out" || echo "N/A" >> "$out"
    echo "--- docker images ---" >> "$out"
    docker images 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  else
    echo "Docker not installed" >> "$out"
  fi
  if cmd_exists podman; then
    echo "--- podman ps ---" >> "$out"
    podman ps 2>/dev/null >> "$out" || echo "N/A" >> "$out"
  fi
}

# ── Master collect ─────────────────────────────────────────────────────────────
run_checks() {
  local out="$1"
  local mode_label="$2"

  log "Starting $mode_label checks -> ${out}"

  {
    echo "=========================================="
    echo " PATCH CHECK REPORT -- $mode_label"
    echo " Host      : ${HOSTNAME}"
    echo " Generated : $(date)"
    echo " Kernel    : $(uname -r)"
    echo "=========================================="
  } > "$out"

  local steps=(
    "Patch Level"        collect_patch_level
    "System Info"        collect_system_info
    "Installed Packages" collect_packages
    "Kernel Modules"     collect_kernel_modules
    "Services"           collect_services
    "Network"            collect_network
    "Disk"               collect_disk
    "Memory"             collect_memory
    "CPU"                collect_cpu
    "Security"           collect_security
    "Scheduled Jobs"     collect_scheduled_jobs
    "Kernel Parameters"  collect_kernel_params
    "Repositories"       collect_repos
    "Processes"          collect_processes
    "System Logs"        collect_system_logs
    "Log Rotation"       collect_log_rotation
    "RPM Verify"         collect_rpm_checksums
    "File Integrity"     collect_file_integrity_hints
    "NTP/Time"           collect_ntp
    "HA Cluster"         collect_ha_cluster
    "Containers"         collect_docker
  )

  local total=$(( ${#steps[@]} / 2 ))
  local i=0
  while [ $i -lt ${#steps[@]} ]; do
    local label="${steps[$i]}"
    local func="${steps[$((i+1))]}"
    log "  [$((i/2+1))/${total}] Collecting: ${label}"
    if [ "$func" = "collect_packages" ]; then
      collect_packages "$out" ""
    elif [ "$func" = "collect_patch_level" ]; then
      collect_patch_level "$out" "$mode_label"
    else
      $func "$out"
    fi
    i=$((i+2))
  done

  # Update the LATEST symlink
  local latest_link
  if [ "$mode_label" = "PRE" ]; then
    latest_link="$PRE_LATEST"
  else
    latest_link="$POST_LATEST"
  fi
  ln -sf "$out" "$latest_link"

  success "$mode_label checks complete -> $out"
  log  "Symlink updated  -> $latest_link"
}

# ── Compare ───────────────────────────────────────────────────────────────────
run_compare() {
  if [ ! -f "$PRE_REPORT" ]; then
    error "Pre-patch report not found: $PRE_REPORT"
    error "Run:  sudo bash $0 pre   before patching."
    exit 1
  fi
  if [ ! -f "$POST_REPORT" ]; then
    error "Post-patch report not found: $POST_REPORT"
    error "Run:  sudo bash $0 post  after patching."
    exit 1
  fi

  log "Generating comparison report -> ${COMPARE_REPORT}"

  {
    echo "=========================================================="
    echo " PATCH COMPARISON REPORT"
    echo " Host      : ${HOSTNAME}"
    echo " Generated : $(date)"
    echo " PRE  file : ${PRE_REPORT}"
    echo " POST file : ${POST_REPORT}"
    echo "=========================================================="
  } > "$COMPARE_REPORT"

  # ── SCBrel patch level — FIRST section, screen + log ──
  local PRE_SCBREL POST_SCBREL
  PRE_SCBREL=$(awk '/^# PATCH LEVEL/{found=1;next} found && /^########################################/{exit} found && NF{print;exit}' \
    "$PRE_REPORT" 2>/dev/null)
  POST_SCBREL=$(awk '/^# PATCH LEVEL/{found=1;next} found && /^########################################/{exit} found && NF{print;exit}' \
    "$POST_REPORT" 2>/dev/null)

  PRE_SCBREL="${PRE_SCBREL:-(SCBrel package not found in PRE report)}"
  POST_SCBREL="${POST_SCBREL:-(SCBrel package not found in POST report)}"

  # Write to compare report file
  {
    echo ""
    echo "=================================================="
    echo " PATCH LEVEL (SCBrel)"
    echo "=================================================="
    echo "  PRE  (before patching) : ${PRE_SCBREL}"
    echo "  POST (after  patching) : ${POST_SCBREL}"
    if [ "$PRE_SCBREL" = "$POST_SCBREL" ]; then
      echo "  STATUS : UNCHANGED -- patch level did not change"
    else
      echo "  STATUS : *** CHANGED *** -- patch level updated successfully"
    fi
    echo "=================================================="
  } >> "$COMPARE_REPORT"

  # Print on screen prominently
  echo ""
  echo -e "${BOLD}┌──────────────────────────────────────────────────────────┐${RESET}"
  echo -e "${BOLD}│  PATCH LEVEL CHANGE (SCBrel)                             │${RESET}"
  echo -e "${BOLD}├──────────────────────────────────────────────────────────┤${RESET}"
  printf "${BOLD}│  %-10s : ${CYAN}%-45s${RESET}${BOLD}│${RESET}\n" "PRE (before)" "${PRE_SCBREL}"
  printf "${BOLD}│  %-10s : ${CYAN}%-45s${RESET}${BOLD}│${RESET}\n" "POST (after)" "${POST_SCBREL}"
  echo -e "${BOLD}├──────────────────────────────────────────────────────────┤${RESET}"
  if [ "$PRE_SCBREL" = "$POST_SCBREL" ]; then
    echo -e "${BOLD}│  STATUS : ${YELLOW}UNCHANGED${RESET}${BOLD} -- patch level did not change           │${RESET}"
  else
    echo -e "${BOLD}│  STATUS : ${GREEN}UPDATED ✔${RESET}${BOLD} -- patch level changed successfully     │${RESET}"
  fi
  echo -e "${BOLD}└──────────────────────────────────────────────────────────┘${RESET}"
  echo ""

  # ── Kernel version ──
  {
    echo ""
    echo "=================================================="
    echo " KERNEL VERSION"
    echo "=================================================="
    PRE_KERN=$(grep '^Kernel' "$PRE_REPORT" | head -1 | awk '{print $NF}')
    POST_KERN=$(grep '^Kernel' "$POST_REPORT" | head -1 | awk '{print $NF}')
    echo "  PRE  : ${PRE_KERN:-(unknown)}"
    echo "  POST : ${POST_KERN:-(unknown)}"
    if [ "$PRE_KERN" != "$POST_KERN" ]; then
      echo "  STATUS : *** KERNEL CHANGED ***"
    else
      echo "  STATUS : no change"
    fi
  } >> "$COMPARE_REPORT"

  # ── Package diff ──
  {
    echo ""
    echo "=================================================="
    echo " PACKAGE CHANGES"
    echo "=================================================="
  } >> "$COMPARE_REPORT"

  if grep -q '^ii' "$PRE_REPORT" 2>/dev/null; then
    grep '^ii' "$PRE_REPORT"  | awk '{print $2"\t"$3}' | sort > /tmp/_pre_pkgs.txt
    grep '^ii' "$POST_REPORT" | awk '{print $2"\t"$3}' | sort > /tmp/_post_pkgs.txt
  else
    awk '/^# INSTALLED PACKAGES/{found=1; next} found && /^########################################/{exit} found{print}' \
      "$PRE_REPORT"  | grep -v '^$' | sort > /tmp/_pre_pkgs.txt
    awk '/^# INSTALLED PACKAGES/{found=1; next} found && /^########################################/{exit} found{print}' \
      "$POST_REPORT" | grep -v '^$' | sort > /tmp/_post_pkgs.txt
  fi

  {
    echo ""
    echo "--- NEWLY INSTALLED PACKAGES ---"
    comm -13 /tmp/_pre_pkgs.txt /tmp/_post_pkgs.txt | head -200 || echo "  None"
    echo ""
    echo "--- REMOVED PACKAGES ---"
    comm -23 /tmp/_pre_pkgs.txt /tmp/_post_pkgs.txt | head -200 || echo "  None"
    echo ""
    echo "--- UPDATED PACKAGES ---"
    if grep -q '^ii' "$PRE_REPORT" 2>/dev/null; then
      sort /tmp/_pre_pkgs.txt  > /tmp/_pre_pkgs_sorted.txt
      sort /tmp/_post_pkgs.txt > /tmp/_post_pkgs_sorted.txt
      join /tmp/_pre_pkgs_sorted.txt /tmp/_post_pkgs_sorted.txt \
        | awk '{if ($2 != $3) print "  " $1 "  " $2 " -> " $3}' | head -200 \
        || echo "  None"
      rm -f /tmp/_pre_pkgs_sorted.txt /tmp/_post_pkgs_sorted.txt
    else
      awk '{sub(/\.[^.]+$/, "", $0); sub(/-[0-9].*$/, "", $0); print}' \
        /tmp/_pre_pkgs.txt  | sort -u > /tmp/_rpm_pre_names.txt
      awk '{sub(/\.[^.]+$/, "", $0); sub(/-[0-9].*$/, "", $0); print}' \
        /tmp/_post_pkgs.txt | sort -u > /tmp/_rpm_post_names.txt
      comm -12 /tmp/_rpm_pre_names.txt /tmp/_rpm_post_names.txt > /tmp/_common_names.txt
      echo "  (inspect full diff below for version deltas)"
      head -20 /tmp/_common_names.txt | sed 's/^/  /'
      rm -f /tmp/_rpm_pre_names.txt /tmp/_rpm_post_names.txt /tmp/_common_names.txt
    fi
    rm -f /tmp/_pre_pkgs.txt /tmp/_post_pkgs.txt
  } >> "$COMPARE_REPORT"

  # ── Service diff ──
  {
    echo ""
    echo "=================================================="
    echo " SERVICE CHANGES"
    echo "=================================================="
  } >> "$COMPARE_REPORT"

  awk '/^# SYSTEMD SERVICES .running./{found=1; next} found && /^########################################/{exit} found{print}' \
    "$PRE_REPORT"  | awk '{print $1}' | sort > /tmp/_pre_svc.txt
  awk '/^# SYSTEMD SERVICES .running./{found=1; next} found && /^########################################/{exit} found{print}' \
    "$POST_REPORT" | awk '{print $1}' | sort > /tmp/_post_svc.txt

  {
    echo ""
    echo "--- SERVICES STARTED (new in POST) ---"
    comm -13 /tmp/_pre_svc.txt /tmp/_post_svc.txt || echo "  None"
    echo ""
    echo "--- SERVICES STOPPED (missing from POST) ---"
    comm -23 /tmp/_pre_svc.txt /tmp/_post_svc.txt || echo "  None"
    rm -f /tmp/_pre_svc.txt /tmp/_post_svc.txt
  } >> "$COMPARE_REPORT"

  # ── Listening port diff ──
  {
    echo ""
    echo "=================================================="
    echo " LISTENING PORT CHANGES"
    echo "=================================================="
  } >> "$COMPARE_REPORT"

  awk '/^# LISTENING PORTS/{found=1; next} found && /^########################################/{exit} found && /LISTEN/{print $5}' \
    "$PRE_REPORT"  | sort -u > /tmp/_pre_ports.txt
  awk '/^# LISTENING PORTS/{found=1; next} found && /^########################################/{exit} found && /LISTEN/{print $5}' \
    "$POST_REPORT" | sort -u > /tmp/_post_ports.txt

  {
    echo ""
    echo "--- NEW LISTENING PORTS ---"
    comm -13 /tmp/_pre_ports.txt /tmp/_post_ports.txt || echo "  None"
    echo ""
    echo "--- CLOSED PORTS ---"
    comm -23 /tmp/_pre_ports.txt /tmp/_post_ports.txt || echo "  None"
    rm -f /tmp/_pre_ports.txt /tmp/_post_ports.txt
  } >> "$COMPARE_REPORT"

  # ── Disk usage diff ──
  {
    echo ""
    echo "=================================================="
    echo " DISK USAGE CHANGES"
    echo "=================================================="
  } >> "$COMPARE_REPORT"

  awk '/^# DISK USAGE/{found=1; next} found && /^########################################/{exit} found{print}' \
    "$PRE_REPORT"  | grep -v '^$' > /tmp/_pre_disk.txt
  awk '/^# DISK USAGE/{found=1; next} found && /^########################################/{exit} found{print}' \
    "$POST_REPORT" | grep -v '^$' > /tmp/_post_disk.txt

  {
    echo ""
    diff /tmp/_pre_disk.txt /tmp/_post_disk.txt | grep -E '^[<>]' \
      | sed 's/^< /PRE : /' | sed 's/^> /POST: /' || echo "  No changes"
    rm -f /tmp/_pre_disk.txt /tmp/_post_disk.txt
  } >> "$COMPARE_REPORT"

  # ── Kernel module diff ──
  {
    echo ""
    echo "=================================================="
    echo " KERNEL MODULE CHANGES"
    echo "=================================================="
  } >> "$COMPARE_REPORT"

  awk '/^# LOADED KERNEL MODULES/{found=1; next} found && /^########################################/{exit} found{print $1}' \
    "$PRE_REPORT"  | sort > /tmp/_pre_mod.txt
  awk '/^# LOADED KERNEL MODULES/{found=1; next} found && /^########################################/{exit} found{print $1}' \
    "$POST_REPORT" | sort > /tmp/_post_mod.txt

  {
    echo ""
    echo "--- NEW MODULES LOADED ---"
    comm -13 /tmp/_pre_mod.txt /tmp/_post_mod.txt || echo "  None"
    echo ""
    echo "--- MODULES UNLOADED ---"
    comm -23 /tmp/_pre_mod.txt /tmp/_post_mod.txt || echo "  None"
    rm -f /tmp/_pre_mod.txt /tmp/_post_mod.txt
  } >> "$COMPARE_REPORT"

  # ── File integrity diff ──
  {
    echo ""
    echo "=================================================="
    echo " KEY CONFIG FILE INTEGRITY CHANGES"
    echo "=================================================="
  } >> "$COMPARE_REPORT"

  awk '/^# KEY CONFIG FILE CHECKSUMS/{found=1; next} found && /^########################################/{exit} found{print}' \
    "$PRE_REPORT"  | sort > /tmp/_pre_sha.txt
  awk '/^# KEY CONFIG FILE CHECKSUMS/{found=1; next} found && /^########################################/{exit} found{print}' \
    "$POST_REPORT" | sort > /tmp/_post_sha.txt

  {
    echo ""
    diff /tmp/_pre_sha.txt /tmp/_post_sha.txt \
      | grep -E '^[<>]' \
      | sed 's/^< /PRE : /' | sed 's/^> /POST: /' || echo "  No changes (all checksums match)"
    rm -f /tmp/_pre_sha.txt /tmp/_post_sha.txt
  } >> "$COMPARE_REPORT"

  # ── Log rotation diff ──
  {
    echo ""
    echo "=================================================="
    echo " LOG ROTATION CHANGES"
    echo "=================================================="
  } >> "$COMPARE_REPORT"

  awk '/^# LOGROTATE GLOBAL CONFIG/{found=1;next} found && /^########################################/{exit} found{print}' \
    "$PRE_REPORT"  | grep -v '^$' | sort > /tmp/_pre_logrot.txt
  awk '/^# LOGROTATE GLOBAL CONFIG/{found=1;next} found && /^########################################/{exit} found{print}' \
    "$POST_REPORT" | grep -v '^$' | sort > /tmp/_post_logrot.txt
  {
    echo ""
    echo "--- logrotate.conf changes ---"
    diff /tmp/_pre_logrot.txt /tmp/_post_logrot.txt \
      | grep -E '^[<>]' | sed 's/^< /PRE : /' | sed 's/^> /POST: /' \
      || echo "  No changes"
    rm -f /tmp/_pre_logrot.txt /tmp/_post_logrot.txt
  } >> "$COMPARE_REPORT"

  awk '/^# LOGROTATE DROP-IN CONFIGS/{found=1;next} found && /^########################################/{exit} found{print}' \
    "$PRE_REPORT"  | grep -v '^$' | sort > /tmp/_pre_logd.txt
  awk '/^# LOGROTATE DROP-IN CONFIGS/{found=1;next} found && /^########################################/{exit} found{print}' \
    "$POST_REPORT" | grep -v '^$' | sort > /tmp/_post_logd.txt
  {
    echo ""
    echo "--- logrotate.d/* changes ---"
    diff /tmp/_pre_logd.txt /tmp/_post_logd.txt \
      | grep -E '^[<>]' | sed 's/^< /PRE : /' | sed 's/^> /POST: /' \
      || echo "  No changes"
    rm -f /tmp/_pre_logd.txt /tmp/_post_logd.txt
  } >> "$COMPARE_REPORT"

  awk '/^# LOGROTATE STATE FILE/{found=1;next} found && /^########################################/{exit} found{print}' \
    "$PRE_REPORT"  | grep -v '^$' | sort > /tmp/_pre_lstate.txt
  awk '/^# LOGROTATE STATE FILE/{found=1;next} found && /^########################################/{exit} found{print}' \
    "$POST_REPORT" | grep -v '^$' | sort > /tmp/_post_lstate.txt
  {
    echo ""
    echo "--- logrotate state changes (rotation timestamps) ---"
    diff /tmp/_pre_lstate.txt /tmp/_post_lstate.txt \
      | grep -E '^[<>]' | sed 's/^< /PRE : /' | sed 's/^> /POST: /' \
      || echo "  No changes"
    rm -f /tmp/_pre_lstate.txt /tmp/_post_lstate.txt
  } >> "$COMPARE_REPORT"

  awk '/^# JOURNALD DISK USAGE/{found=1;next} found && /^########################################/{exit} found{print}' \
    "$PRE_REPORT"  | grep -v '^$' > /tmp/_pre_jdu.txt
  awk '/^# JOURNALD DISK USAGE/{found=1;next} found && /^########################################/{exit} found{print}' \
    "$POST_REPORT" | grep -v '^$' > /tmp/_post_jdu.txt
  {
    echo ""
    echo "--- journald disk usage change ---"
    diff /tmp/_pre_jdu.txt /tmp/_post_jdu.txt \
      | grep -E '^[<>]' | sed 's/^< /PRE : /' | sed 's/^> /POST: /' \
      || echo "  No changes"
    rm -f /tmp/_pre_jdu.txt /tmp/_post_jdu.txt
  } >> "$COMPARE_REPORT"

  # ── Log error diff ──
  {
    echo ""
    echo "=================================================="
    echo " NEW LOG ERRORS (present in POST, absent in PRE)"
    echo "=================================================="
  } >> "$COMPARE_REPORT"

  _extract_log_section() {
    local report="$1" section_label="$2" dest="$3"
    awk "/^# ${section_label}/{found=1; next} found && /^########################################/{exit} found{print}" \
      "$report" 2>/dev/null | grep -v '^$' | sort -u > "$dest" || true
  }

  local any_new_error=0

  for section_label in \
      "JOURNALD ERRORS (priority: emerg/alert/crit/err)" \
      "DMESG ERRORS (err/crit/alert/emerg)" \
      "SYSLOG ERRORS (/var/log/messages or syslog)" \
      "KERNEL LOG ERRORS (/var/log/kern.log)" \
      "AUTH ERRORS (/var/log/auth.log or secure)" \
      "AUDIT LOG ERRORS (/var/log/audit/audit.log)" \
      "FAILED SYSTEMD UNITS (journald)"; do

    _extract_log_section "$PRE_REPORT"  "$section_label" /tmp/_log_pre.txt
    _extract_log_section "$POST_REPORT" "$section_label" /tmp/_log_post.txt

    new_errors=$(comm -13 /tmp/_log_pre.txt /tmp/_log_post.txt 2>/dev/null || true)
    cleared_errors=$(comm -23 /tmp/_log_pre.txt /tmp/_log_post.txt 2>/dev/null || true)

    if [ -n "$new_errors" ] || [ -n "$cleared_errors" ]; then
      {
        echo ""
        echo "  +-- $section_label"
        if [ -n "$new_errors" ]; then
          any_new_error=1
          echo "  |  [NEW -- appeared after patching]"
          echo "$new_errors" | sed 's/^/  |    /'
        fi
        if [ -n "$cleared_errors" ]; then
          echo "  |  [CLEARED -- gone after patching]"
          echo "$cleared_errors" | sed 's/^/  |    /'
        fi
        echo "  +--"
      } >> "$COMPARE_REPORT"
    fi
    rm -f /tmp/_log_pre.txt /tmp/_log_post.txt
  done

  if [ "$any_new_error" -eq 0 ]; then
    echo "  No new log errors detected after patching." >> "$COMPARE_REPORT"
  fi

  # ── Full raw diff ──
  {
    echo ""
    echo "=================================================="
    echo " FULL DIFF (PRE -> POST)"
    echo "=================================================="
    echo ""
  } >> "$COMPARE_REPORT"
  diff "$PRE_REPORT" "$POST_REPORT" >> "$COMPARE_REPORT" 2>/dev/null || true

  ln -sf "$COMPARE_REPORT" "$COMPARE_LATEST"
  success "Comparison report saved -> ${COMPARE_REPORT}"
  log    "Symlink updated  -> ${COMPARE_LATEST}"
  echo ""
  echo -e "${BOLD}Quick summary (key changes):${RESET}"
  grep -E 'CHANGED|UPDATED|NEW LISTENING|CLOSED|NEWLY INSTALLED|REMOVED|STARTED|STOPPED|MODULES|NEW --|CLEARED --|No new log' \
    "$COMPARE_REPORT" | head -60 || true
}

# ── Usage ─────────────────────────────────────────────────────────────────────
usage() {
  echo ""
  echo -e "${BOLD}Usage:${RESET}  sudo bash $0 {pre|post|compare}"
  echo ""
  echo "  pre      -- Collect pre-patch snapshot  -> pre/PRE_PATCH_<host>_YYYYMMDD.txt"
  echo "  post     -- Collect post-patch snapshot -> post/POST_PATCH_<host>_YYYYMMDD.txt"
  echo "  compare  -- Generate diff report        -> diff/COMPARISON_<host>_YYYYMMDD_HHMMSS.txt"
  echo ""
  echo "Reports are saved under : ${REPORT_DIR}/"
  echo "Retention policy        : ${RETENTION_DAYS} days (6 months), auto-purged on each run"
  echo "Latest symlinks         : ${REPORT_DIR}/LATEST_*.txt"
  echo ""
}

# ── Main ──────────────────────────────────────────────────────────────────────
check_root
ensure_dirs
purge_old_reports

case "$MODE" in
  pre)
    header "PRE-PATCH CHECKS  --  ${HOSTNAME}"
    run_checks "$PRE_REPORT" "PRE"
    echo ""
    log "Pre-patch report : ${PRE_REPORT}"
    log "Stable symlink   : ${PRE_LATEST}"
    log "Now apply your patches, then run:  sudo bash $0 post"
    ;;
  post)
    header "POST-PATCH CHECKS  --  ${HOSTNAME}"
    run_checks "$POST_REPORT" "POST"
    echo ""
    log "Post-patch report: ${POST_REPORT}"
    log "Stable symlink   : ${POST_LATEST}"
    log "To compare, run:  sudo bash $0 compare"
    ;;
  compare)
    header "COMPARISON REPORT  --  ${HOSTNAME}"
    run_compare
    echo ""
    log "Full comparison  : ${COMPARE_REPORT}"
    log "Stable symlink   : ${COMPARE_LATEST}"
    ;;
  *)
    usage
    exit 1
    ;;
esac
