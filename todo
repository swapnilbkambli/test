        # â”€â”€ Status bar â”€â”€
        self.status_var = tk.StringVar(value="Ready")
        tk.Label(self.window, textvariable=self.status_var,
                 font=("Segoe UI", 9), bg="#ddd",
                 anchor=tk.W, padx=8, pady=3).pack(fill=tk.X, side=tk.BOTTOM)

    # â”€â”€ Task operations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def refresh_tasks(self):
        if not self.window or not self.window.winfo_exists():
            return
        date_filter = self.date_var.get().strip()
        self.listbox.delete(0, tk.END)
        self.displayed_tasks = []
        filtered = [t for t in self.tasks
                    if not date_filter or t["date"] == date_filter]
        # Pending first, completed at the bottom
        sorted_tasks = [t for t in filtered if not t["done"]] + \
                       [t for t in filtered if t["done"]]
        for task in sorted_tasks:
            self.displayed_tasks.append(task)
            status = "âœ“" if task["done"] else "â—‹"
            reminder = task.get("reminder", "")
            rem_date = task.get("reminder_date", task["date"])
            if reminder and not task["done"]:
                rem_str = f" â°{rem_date} {reminder}" if rem_date != task["date"] else f" â°{reminder}"
            else:
                rem_str = ""
            self.listbox.insert(tk.END, f"  {status}  [{task['date']}]{rem_str}  {task['text']}")
            if task["done"]:
                self.listbox.itemconfig(tk.END, fg="#aaaaaa", bg="#f8f8f8")
            else:
                c = COLORS.get(task.get("color", "default"), COLORS["default"])
                self.listbox.itemconfig(tk.END, fg=c["fg"], bg=c["bg"])
        pending = sum(1 for t in self.tasks if not t["done"])
        self.status_var.set(
            f"{len(self.tasks)} tasks total  |  {pending} pending  |  "
            f"Hotkey: Ctrl+Alt+T  |  Close: Esc"
        )

    def add_task(self):
        text = self.task_var.get().strip()
        if not text:
            return
        date = self.date_var.get().strip() or datetime.now().strftime("%Y-%m-%d")
        reminder = self.reminder_var.get().strip()
        if reminder in ("HH:MM", ""):
            reminder = ""
        else:
            # Validate HH:MM format
            try:
                datetime.strptime(reminder, "%H:%M")
            except ValueError:
                reminder = ""
        self.tasks.append({
            "text": text,
            "date": date,
            "done": False,
            "color": "default",
            "reminder": reminder,
            "reminder_date": date if reminder else "",
            "reminded": False,
            "created": datetime.now().isoformat()
        })
        save_tasks(self.tasks)
        self.task_var.set("")
        self.reminder_var.set("")
        self.refresh_tasks()

    def _on_double_click(self, event):
        sel = self.listbox.curselection()
        if not sel:
            return
        task = self.displayed_tasks[sel[0]]
        task["done"] = not task["done"]
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _on_right_click(self, event):
        index = self.listbox.nearest(event.y)
        if index < 0 or index >= len(self.displayed_tasks):
            return
        self.listbox.selection_clear(0, tk.END)
        self.listbox.selection_set(index)
        task = self.displayed_tasks[index]
        menu = tk.Menu(self.window, tearoff=0)
        toggle_label = "Mark Incomplete" if task["done"] else "Mark Complete"
        menu.add_command(label=toggle_label, command=self._on_double_click)
        menu.add_command(label="âœ  Edit Task", command=lambda: self._edit_task(index))
        menu.add_separator()
        color_menu = tk.Menu(menu, tearoff=0)
        for clabel, ckey in [
            ("â¬œ  Default", "default"),
            ("ðŸ”´  Red  (High Priority)", "red"),
            ("ðŸŸ   Orange  (Medium Priority)", "orange"),
            ("ðŸŸ¡  Yellow", "yellow"),
            ("ðŸŸ¢  Green  (Low Priority)", "green"),
            ("ðŸ”µ  Blue  (Info)", "blue"),
            ("ðŸŸ£  Purple", "purple"),
        ]:
            color_menu.add_command(
                label=clabel,
                command=lambda k=ckey, i=index: self._set_color(i, k)
            )
        menu.add_cascade(label="ðŸŽ¨  Set Color", menu=color_menu)
        menu.add_command(label="â°  Set Reminder",
                         command=lambda: self._set_reminder_dialog(index))
        menu.add_separator()
        menu.add_command(label="ðŸ—‘  Delete", command=self.delete_task)
        menu.tk_popup(event.x_root, event.y_root)

    def _edit_task(self, index):
        task = self.displayed_tasks[index]
        edit_win = tk.Toplevel(self.window)
        edit_win.title("Edit Task")
        edit_win.geometry("420x130")
        edit_win.resizable(False, False)
        edit_win.configure(bg="#f3f3f3")
        edit_win.attributes("-topmost", True)
        edit_win.grab_set()
        # Center
        edit_win.update_idletasks()
        x = self.window.winfo_x() + (self.window.winfo_width() // 2) - 210
        y = self.window.winfo_y() + (self.window.winfo_height() // 2) - 65
        edit_win.geometry(f"420x130+{x}+{y}")
        tk.Label(edit_win, text="Edit task text:", font=("Segoe UI", 10),
                 bg="#f3f3f3").pack(anchor=tk.W, padx=12, pady=(12, 4))
        var = tk.StringVar(value=task["text"])
        entry = tk.Entry(edit_win, textvariable=var, font=("Segoe UI", 10),
                         relief=tk.FLAT, highlightthickness=1,
                         highlightbackground="#ccc")
        entry.pack(fill=tk.X, padx=12, ipady=4)
        entry.select_range(0, tk.END)
        entry.focus_set()
        def save_edit(event=None):
            new_text = var.get().strip()
            if new_text:
                task["text"] = new_text
                save_tasks(self.tasks)
                self.refresh_tasks()
            edit_win.destroy()
        entry.bind("<Return>", save_edit)
        edit_win.bind("<Escape>", lambda e: edit_win.destroy())
        bf = tk.Frame(edit_win, bg="#f3f3f3")
        bf.pack(fill=tk.X, padx=12, pady=8)
        tk.Button(bf, text="Save", command=save_edit, font=("Segoe UI", 10),
                  bg="#0078d4", fg="white", relief=tk.FLAT,
                  padx=10, pady=3).pack(side=tk.LEFT, padx=(0, 6))
        tk.Button(bf, text="Cancel", command=edit_win.destroy,
                  font=("Segoe UI", 10), bg="#555555", fg="white",
                  relief=tk.FLAT, padx=10, pady=3).pack(side=tk.LEFT)

    def _set_reminder_dialog(self, index):
        from datetime import timedelta
        task = self.displayed_tasks[index]

        dlg = tk.Toplevel(self.window)
        dlg.title("â°  Set Reminder")
        dlg.geometry("430x350")
        dlg.resizable(False, False)
        dlg.configure(bg="#f3f3f3")
        dlg.attributes("-topmost", True)
        dlg.grab_set()
        dlg.update_idletasks()
        x = (dlg.winfo_screenwidth() // 2) - 215
        y = (dlg.winfo_screenheight() // 2) - 175
        dlg.geometry(f"430x350+{x}+{y}")

        # â”€â”€ Working vars â”€â”€
        rd_var  = tk.StringVar(value=task.get("reminder_date") or task.get("date", ""))
        rt_var  = tk.StringVar(value=task.get("reminder", ""))

        def apply_delta(delta_minutes=None, delta_days=None, hour=9):
            """Fill date/time fields from a relative offset and close."""
            now = datetime.now()
            if delta_minutes is not None:
                target = now + timedelta(minutes=delta_minutes)
                rd_var.set(target.strftime("%Y-%m-%d"))
                rt_var.set(target.strftime("%H:%M"))
            elif delta_days is not None:
                target = now + timedelta(days=delta_days)
                rd_var.set(target.strftime("%Y-%m-%d"))
                rt_var.set(f"{hour:02d}:00")

        def save_and_close():
            date_val = rd_var.get().strip()
            time_val = rt_var.get().strip()
            if time_val:
                try:
                    datetime.strptime(time_val, "%H:%M")
                except ValueError:
                    time_val = ""
            if date_val:
                try:
                    datetime.strptime(date_val, "%Y-%m-%d")
                except ValueError:
                    date_val = ""
            task["reminder"]      = time_val
            task["reminder_date"] = date_val if time_val else ""
            task["reminded"]      = False
            save_tasks(self.tasks)
            self.refresh_tasks()
            dlg.destroy()

        def clear_and_close():
            task["reminder"]      = ""
            task["reminder_date"] = ""
            task["reminded"]      = False
            save_tasks(self.tasks)
            self.refresh_tasks()
            dlg.destroy()

        # â”€â”€ Quick presets â”€â”€
        BG = "#f3f3f3"
        tk.Label(dlg, text="Quick reminders", font=("Segoe UI", 9, "bold"),
                 bg=BG, fg="#555").pack(anchor="w", padx=16, pady=(12, 2))

        row1 = tk.Frame(dlg, bg=BG); row1.pack(fill=tk.X, padx=14, pady=2)
        for label, mins in [("15 min", 15), ("30 min", 30),
                             ("1 hour", 60), ("2 hours", 120), ("4 hours", 240)]:
            tk.Button(row1, text=label,
                      command=lambda m=mins: [apply_delta(delta_minutes=m), save_and_close()],
                      font=("Segoe UI", 9), bg="#e1efff", fg="#0050a0",
                      relief=tk.FLAT, padx=7, pady=3).pack(side=tk.LEFT, padx=3)

        row2 = tk.Frame(dlg, bg=BG); row2.pack(fill=tk.X, padx=14, pady=2)
        for label, days in [("Tomorrow", 1), ("In 2 days", 2),
                             ("In 3 days", 3), ("Next week", 7), ("In 2 weeks", 14)]:
            tk.Button(row2, text=label,
                      command=lambda d=days: [apply_delta(delta_days=d, hour=9), save_and_close()],
                      font=("Segoe UI", 9), bg="#e8f5e9", fg="#1b5e20",
                      relief=tk.FLAT, padx=7, pady=3).pack(side=tk.LEFT, padx=3)

        # â”€â”€ Custom offset â”€â”€
        tk.Frame(dlg, bg="#ccc", height=1).pack(fill=tk.X, padx=14, pady=8)
        tk.Label(dlg, text="Custom offset", font=("Segoe UI", 9, "bold"),
                 bg=BG, fg="#555").pack(anchor="w", padx=16)
        crow = tk.Frame(dlg, bg=BG); crow.pack(fill=tk.X, padx=14, pady=4)
        tk.Label(crow, text="In", font=("Segoe UI", 10), bg=BG).pack(side=tk.LEFT)
        amt_var = tk.StringVar(value="1")
        tk.Spinbox(crow, from_=1, to=999, textvariable=amt_var, width=4,
                   font=("Segoe UI", 10)).pack(side=tk.LEFT, padx=5)
        unit_var = tk.StringVar(value="hours")
        unit_menu = tk.OptionMenu(crow, unit_var, "hours", "days", "weeks")
        unit_menu.config(font=("Segoe UI", 10), bg="white", relief=tk.FLAT)
        unit_menu.pack(side=tk.LEFT)

        def apply_custom():
            try:
                amt = int(amt_var.get())
            except ValueError:
                return
            unit = unit_var.get()
            if unit == "hours":
                apply_delta(delta_minutes=amt * 60)
            elif unit == "days":
                apply_delta(delta_days=amt, hour=9)
            elif unit == "weeks":
                apply_delta(delta_days=amt * 7, hour=9)
            save_and_close()

        tk.Button(crow, text="Set â†’", command=apply_custom,
                  font=("Segoe UI", 9, "bold"), bg="#0078d4", fg="white",
                  relief=tk.FLAT, padx=8, pady=2).pack(side=tk.LEFT, padx=8)

        # â”€â”€ Exact date & time â”€â”€
        tk.Frame(dlg, bg="#ccc", height=1).pack(fill=tk.X, padx=14, pady=8)
        tk.Label(dlg, text="Exact date & time", font=("Segoe UI", 9, "bold"),
                 bg=BG, fg="#555").pack(anchor="w", padx=16)
        erow = tk.Frame(dlg, bg=BG); erow.pack(fill=tk.X, padx=14, pady=4)
        tk.Label(erow, text="Date:", font=("Segoe UI", 10), bg=BG).pack(side=tk.LEFT)
        tk.Entry(erow, textvariable=rd_var, width=12, font=("Segoe UI", 10),
                 relief=tk.FLAT, highlightthickness=1,
                 highlightbackground="#ccc").pack(side=tk.LEFT, padx=5, ipady=3)
        tk.Label(erow, text="Time:", font=("Segoe UI", 10), bg=BG).pack(side=tk.LEFT)
        tk.Entry(erow, textvariable=rt_var, width=7, font=("Segoe UI", 10),
                 relief=tk.FLAT, highlightthickness=1,
                 highlightbackground="#ccc").pack(side=tk.LEFT, padx=5, ipady=3)

        # â”€â”€ Buttons â”€â”€
        brow = tk.Frame(dlg, bg=BG); brow.pack(fill=tk.X, padx=14, pady=(10, 8))
        tk.Button(brow, text="âœ“  Set Reminder", command=save_and_close,
                  font=("Segoe UI", 10, "bold"), bg="#0078d4", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=(0, 6))
        tk.Button(brow, text="âœ•  Clear", command=clear_and_close,
                  font=("Segoe UI", 10), bg="#d13438", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=(0, 6))
        tk.Button(brow, text="Cancel", command=dlg.destroy,
                  font=("Segoe UI", 10), bg="#555", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT)
        dlg.bind("<Escape>", lambda e: dlg.destroy())

    def _show_reminder_popup(self, task):
        popup = tk.Toplevel()
        popup.title("â° Reminder")
        popup.geometry("380x160")
        popup.resizable(False, False)
        popup.configure(bg="#fff3e0")
        popup.attributes("-topmost", True)
        popup.lift()
        popup.focus_force()
        # Center
        popup.update_idletasks()
        x = (popup.winfo_screenwidth() // 2) - 190
        y = (popup.winfo_screenheight() // 2) - 80
        popup.geometry(f"380x160+{x}+{y}")
        tk.Label(popup, text="â°  Reminder!", font=("Segoe UI", 13, "bold"),
                 bg="#fff3e0", fg="#e65100").pack(pady=(18, 4))
        tk.Label(popup, text=task["text"], font=("Segoe UI", 11),
                 bg="#fff3e0", fg="#333", wraplength=340).pack(pady=4)
        rem_date = task.get("reminder_date") or task["date"]
        tk.Label(popup, text=f"Scheduled: {rem_date}  {task.get('reminder', '')}",
                 font=("Segoe UI", 9), bg="#fff3e0", fg="#888").pack()
        bf = tk.Frame(popup, bg="#fff3e0")
        bf.pack(pady=10)
        tk.Button(bf, text="âœ“  Done",
                  command=lambda: [self._mark_reminded_done(task), popup.destroy()],
                  font=("Segoe UI", 10), bg="#107c10", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=6)
        tk.Button(bf, text="Dismiss",
                  command=lambda: [self._mark_reminded(task), popup.destroy()],
                  font=("Segoe UI", 10), bg="#555", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT)

    def _mark_reminded(self, task):
        task["reminded"] = True
        save_tasks(self.tasks)

    def _mark_reminded_done(self, task):
        task["reminded"] = True
        task["done"] = True
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _reminder_checker(self):
        """Background thread â€” checks every 30 seconds for due reminders."""
        while True:
            threading.Event().wait(30)
            now = datetime.now()
            today = now.strftime("%Y-%m-%d")
            now_hhmm = now.strftime("%H:%M")
            for task in self.tasks:
                rem_date = task.get("reminder_date") or task.get("date", "")
                if (task.get("reminder") and
                        not task.get("done") and
                        not task.get("reminded") and
                        rem_date == today and
                        task["reminder"] <= now_hhmm):
                    if self.window and self.window.winfo_exists():
                        self.window.after(0, lambda t=task: self._show_reminder_popup(t))

    def _set_color(self, index, color_key):
        self.displayed_tasks[index]["color"] = color_key
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _drag_start(self, event):
        self._drag_start_index = self.listbox.nearest(event.y)
        self._drag_start_y = event.y

    def _drag_motion(self, event):
        if self._drag_start_index is None:
            return
        current = self.listbox.nearest(event.y)
        if current != self._drag_start_index:
            self.listbox.selection_clear(0, tk.END)
            self.listbox.selection_set(current)
            self.listbox.itemconfig(current, bg="#cce4ff")

    def _drag_release(self, event):
        if self._drag_start_index is None:
            return
        end_index = self.listbox.nearest(event.y)
        if abs(event.y - self._drag_start_y) > 8 and end_index != self._drag_start_index:
            task = self.displayed_tasks[self._drag_start_index]
            target_task = self.displayed_tasks[end_index]
            src_idx = self.tasks.index(task)
            tgt_idx = self.tasks.index(target_task)
            self.tasks.insert(tgt_idx, self.tasks.pop(src_idx))
            save_tasks(self.tasks)
            self.refresh_tasks()
            self.listbox.selection_set(end_index)
        self._drag_start_index = None
        self._drag_start_y = None

    def complete_task(self):
        sel = self.listbox.curselection()
        if not sel:
            return
        self.displayed_tasks[sel[0]]["done"] = True
        save_tasks(self.tasks)
        self.refresh_tasks()

    def delete_task(self):
        sel = self.listbox.curselection()
        if not sel:
            return
        self.tasks.remove(self.displayed_tasks[sel[0]])
        save_tasks(self.tasks)
        self.refresh_tasks()

    def set_today(self):
        self.date_var.set(datetime.now().strftime("%Y-%m-%d"))
        self.refresh_tasks()

    def show_all(self):
        self.date_var.set("")
        self.refresh_tasks()

    # â”€â”€ Window visibility â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def hide_window(self):
        if self.window and self.window.winfo_exists():
            self.window.withdraw()

    def show_window(self):
        if self.window and self.window.winfo_exists():
            self.window.deiconify()
            self.window.lift()
            self.window.focus_force()
            self.refresh_tasks()

    def toggle_window(self):
        """Called from hotkey â€” must schedule on main thread via after()."""
        if self.window and self.window.winfo_exists():
            if self.window.state() == "withdrawn":
                self.window.after(0, self.show_window)
            else:
                self.window.after(0, self.hide_window)

    # â”€â”€ Tray â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def _run_tray(self):
        menu = pystray.Menu(
            pystray.MenuItem("Open / Hide  (Ctrl+Alt+T)",
                             lambda: self.window.after(0, self.toggle_window)),
            pystray.Menu.SEPARATOR,
            pystray.MenuItem("Quit", self.quit_app)
        )
        self.tray_icon = pystray.Icon(
            "todo_tracker", create_icon_image(), "Todo Tracker", menu
        )
        self.tray_icon.run()

    def quit_app(self, *_):
        if self.tray_icon:
            self.tray_icon.stop()
        if self.window:
            self.window.destroy()
        os._exit(0)

    # â”€â”€ Entry point â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def run(self):
        self.create_window()
        threading.Thread(target=self._run_tray, daemon=True).start()
        threading.Thread(target=self._reminder_checker, daemon=True).start()
        keyboard.add_hotkey("ctrl+alt+t", self.toggle_window)
        self.window.mainloop()


if __name__ == "__main__":
    app = TodoApp()
    app.run()
