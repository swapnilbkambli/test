    # â”€â”€ Reminder â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def _set_reminder_dialog(self, index):
        task = self.displayed_tasks[index]
        dlg = tk.Toplevel(self.window)
        dlg.title("â°  Set Reminder")
        dlg.geometry("430x355")
        dlg.resizable(False, False)
        dlg.configure(bg=self.T["bg"])
        dlg.attributes("-topmost", True)
        dlg.grab_set()
        dlg.update_idletasks()
        x = (dlg.winfo_screenwidth() // 2) - 215
        y = (dlg.winfo_screenheight() // 2) - 177
        dlg.geometry(f"430x355+{x}+{y}")
        BG, FG = self.T["bg"], self.T["fg"]
        rd_var = tk.StringVar(value=task.get("reminder_date") or task.get("date", ""))
        rt_var = tk.StringVar(value=task.get("reminder", ""))

        def apply_delta(delta_minutes=None, delta_days=None, hour=9):
            now = datetime.now()
            if delta_minutes is not None:
                t = now + timedelta(minutes=delta_minutes)
                rd_var.set(t.strftime("%Y-%m-%d")); rt_var.set(t.strftime("%H:%M"))
            elif delta_days is not None:
                t = now + timedelta(days=delta_days)
                rd_var.set(t.strftime("%Y-%m-%d")); rt_var.set(f"{hour:02d}:00")

        def save_and_close():
            dv, tv = rd_var.get().strip(), rt_var.get().strip()
            if tv:
                try: datetime.strptime(tv, "%H:%M")
                except ValueError: tv = ""
            if dv:
                try: datetime.strptime(dv, "%Y-%m-%d")
                except ValueError: dv = ""
            task["reminder"] = tv; task["reminder_date"] = dv if tv else ""
            task["reminded"] = False
            save_tasks(self.tasks); self.refresh_tasks(); dlg.destroy()

        def clear_and_close():
            task["reminder"] = ""; task["reminder_date"] = ""; task["reminded"] = False
            save_tasks(self.tasks); self.refresh_tasks(); dlg.destroy()

        tk.Label(dlg, text="Quick reminders", font=("Segoe UI", 9, "bold"),
                 bg=BG, fg="#888").pack(anchor="w", padx=16, pady=(12, 2))
        row1 = tk.Frame(dlg, bg=BG); row1.pack(fill=tk.X, padx=14, pady=2)
        for lbl, m in [("15 min", 15), ("30 min", 30), ("1 hour", 60), ("2 hours", 120), ("4 hours", 240)]:
            tk.Button(row1, text=lbl, font=("Segoe UI", 9), bg="#e1efff", fg="#0050a0",
                      relief=tk.FLAT, padx=6, pady=3,
                      command=lambda mm=m: [apply_delta(delta_minutes=mm), save_and_close()]
                      ).pack(side=tk.LEFT, padx=3)
        row2 = tk.Frame(dlg, bg=BG); row2.pack(fill=tk.X, padx=14, pady=2)
        for lbl, d in [("Tomorrow", 1), ("2 days", 2), ("3 days", 3), ("Next week", 7), ("2 weeks", 14)]:
            tk.Button(row2, text=lbl, font=("Segoe UI", 9), bg="#e8f5e9", fg="#1b5e20",
                      relief=tk.FLAT, padx=6, pady=3,
                      command=lambda dd=d: [apply_delta(delta_days=dd, hour=9), save_and_close()]
                      ).pack(side=tk.LEFT, padx=3)
        tk.Frame(dlg, bg="#ccc", height=1).pack(fill=tk.X, padx=14, pady=6)
        crow = tk.Frame(dlg, bg=BG); crow.pack(fill=tk.X, padx=14, pady=2)
        tk.Label(crow, text="In", font=("Segoe UI", 10), bg=BG, fg=FG).pack(side=tk.LEFT)
        amt_var = tk.StringVar(value="1")
        tk.Spinbox(crow, from_=1, to=999, textvariable=amt_var, width=4,
                   font=("Segoe UI", 10)).pack(side=tk.LEFT, padx=5)
        unit_var = tk.StringVar(value="hours")
        tk.OptionMenu(crow, unit_var, "hours", "days", "weeks").pack(side=tk.LEFT)
        def apply_custom():
            try: amt = int(amt_var.get())
            except ValueError: return
            u = unit_var.get()
            if u == "hours": apply_delta(delta_minutes=amt * 60)
            elif u == "days": apply_delta(delta_days=amt, hour=9)
            elif u == "weeks": apply_delta(delta_days=amt * 7, hour=9)
            save_and_close()
        tk.Button(crow, text="Set â†’", command=apply_custom,
                  font=("Segoe UI", 9, "bold"), bg="#0078d4", fg="white",
                  relief=tk.FLAT, padx=8, pady=2).pack(side=tk.LEFT, padx=8)
        tk.Frame(dlg, bg="#ccc", height=1).pack(fill=tk.X, padx=14, pady=6)
        erow = tk.Frame(dlg, bg=BG); erow.pack(fill=tk.X, padx=14, pady=2)
        tk.Label(erow, text="Date:", font=("Segoe UI", 10), bg=BG, fg=FG).pack(side=tk.LEFT)
        tk.Entry(erow, textvariable=rd_var, width=12, font=("Segoe UI", 10),
                 bg=self.T["entry_bg"], fg=FG, relief=tk.FLAT,
                 highlightthickness=1, highlightbackground="#999"
                 ).pack(side=tk.LEFT, padx=5, ipady=3)
        tk.Label(erow, text="Time:", font=("Segoe UI", 10), bg=BG, fg=FG).pack(side=tk.LEFT)
        tk.Entry(erow, textvariable=rt_var, width=7, font=("Segoe UI", 10),
                 bg=self.T["entry_bg"], fg=FG, relief=tk.FLAT,
                 highlightthickness=1, highlightbackground="#999"
                 ).pack(side=tk.LEFT, padx=5, ipady=3)
        brow = tk.Frame(dlg, bg=BG); brow.pack(fill=tk.X, padx=14, pady=(10, 8))
        tk.Button(brow, text="âœ“  Set Reminder", command=save_and_close,
                  font=("Segoe UI", 10, "bold"), bg="#0078d4", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=(0, 6))
        tk.Button(brow, text="âœ•  Clear", command=clear_and_close,
                  font=("Segoe UI", 10), bg="#d13438", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=(0, 6))
        tk.Button(brow, text="Cancel", command=dlg.destroy,
                  font=("Segoe UI", 10), bg="#555", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT)
        dlg.bind("<Escape>", lambda e: dlg.destroy())

