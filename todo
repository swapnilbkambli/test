                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=4)
        tk.Button(bf, text="ðŸ’¤ 10 min",
                  command=lambda: [self._snooze(task, 10), popup.destroy()],
                  font=("Segoe UI", 10), bg="#0078d4", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=4)
        tk.Button(bf, text="ðŸ’¤ 1 hour",
                  command=lambda: [self._snooze(task, 60), popup.destroy()],
                  font=("Segoe UI", 10), bg="#0078d4", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=4)
        tk.Button(bf, text="Dismiss",
                  command=lambda: [self._mark_reminded(task), popup.destroy()],
                  font=("Segoe UI", 10), bg="#555", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=4)

    def _snooze(self, task, minutes):
        t = datetime.now() + timedelta(minutes=minutes)
        task["reminder"]      = t.strftime("%H:%M")
        task["reminder_date"] = t.strftime("%Y-%m-%d")
        task["reminded"]      = False
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _mark_reminded(self, task):
        task["reminded"] = True; save_tasks(self.tasks)

    def _mark_reminded_done(self, task):
        task["reminded"] = True; task["done"] = True
        if task.get("recurring", "none") not in ("none", None, ""):
            self._create_recurring(task)
        save_tasks(self.tasks); self.refresh_tasks()

    def _reminder_checker(self):
        while True:
            threading.Event().wait(30)
            now      = datetime.now()
            today    = now.strftime("%Y-%m-%d")
            now_hhmm = now.strftime("%H:%M")
            # Daily summary at configured time
            summary_time = self.settings.get("summary_time", "09:00")
            if now_hhmm == summary_time and not self._daily_summary_shown:
                self._daily_summary_shown = True
                if self.window and self.window.winfo_exists():
                    self.window.after(0, self._show_daily_summary)
            if now_hhmm != summary_time:
                self._daily_summary_shown = False
            # Auto-backup
            if self._last_backup_date != today:
                self._last_backup_date = today
                auto_backup()
            # Reminders
            for task in self.tasks:
                rem_date = task.get("reminder_date") or task.get("date", "")
                if (task.get("reminder") and not task.get("done") and
                        not task.get("reminded") and
                        rem_date == today and task["reminder"] <= now_hhmm):
                    if self.window and self.window.winfo_exists():
                        self.window.after(0, lambda t=task: self._show_reminder_popup(t))

    def _show_daily_summary(self):
        today = datetime.now().strftime("%Y-%m-%d")
        pending = [t for t in self.tasks
                   if not t["done"] and not t.get("archived") and t["date"] == today]
        if not pending:
            return
        popup = tk.Toplevel()
        popup.title("ðŸ“‹  Today's Tasks")
        popup.geometry("380x300")
        popup.resizable(True, True)
        popup.configure(bg="#e8f0fe")
        popup.attributes("-topmost", True)
        popup.lift(); popup.focus_force()
        popup.update_idletasks()
        x = (popup.winfo_screenwidth() // 2) - 190
        y = (popup.winfo_screenheight() // 2) - 150
        popup.geometry(f"380x300+{x}+{y}")
        tk.Label(popup, text=f"ðŸ“‹  Good morning!  {len(pending)} task(s) today",
                 font=("Segoe UI", 12, "bold"), bg="#e8f0fe", fg="#1a237e").pack(pady=(16, 8))
        lb = tk.Listbox(popup, font=("Segoe UI", 10), bg="white", relief=tk.FLAT, bd=1, height=10)
        lb.pack(fill=tk.BOTH, expand=True, padx=12)
        for t in pending:
            pri = PRIORITIES.get(t.get("priority", "none"), PRIORITIES["none"])["icon"]
            lb.insert(tk.END, f"  {pri}  {t['text']}")
        bf = tk.Frame(popup, bg="#e8f0fe"); bf.pack(pady=8)
        tk.Button(bf, text="Open Tracker",
                  command=lambda: [self.show_window(), popup.destroy()],
                  font=("Segoe UI", 10), bg="#0078d4", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT, padx=6)
        tk.Button(bf, text="Dismiss", command=popup.destroy,
                  font=("Segoe UI", 10), bg="#555", fg="white",
                  relief=tk.FLAT, padx=10, pady=4).pack(side=tk.LEFT)

    # â”€â”€ Tray badge â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def _update_tray_badge(self, pending):
        if self.tray_icon:
            try:
                self.tray_icon.icon  = create_icon_image(pending)
                self.tray_icon.title = f"Todo Tracker  ({pending} pending)"
            except Exception:
                pass

    # â”€â”€ Settings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def _show_settings(self):
        win = tk.Toplevel(self.window)
        win.title("âš™  Settings")
        win.geometry("380x200")
        win.resizable(False, False)
        win.configure(bg=self.T["bg"])
        win.attributes("-topmost", True)
        win.grab_set()
        win.update_idletasks()
        x = self.window.winfo_x() + self.window.winfo_width() // 2 - 190
        y = self.window.winfo_y() + 60
        win.geometry(f"380x200+{x}+{y}")
        BG, FG = self.T["bg"], self.T["fg"]

        tk.Label(win, text="âš™  Settings", font=("Segoe UI", 12, "bold"),
                 bg=BG, fg=FG).pack(pady=(16, 12))

        row = tk.Frame(win, bg=BG); row.pack(fill=tk.X, padx=24, pady=4)
        tk.Label(row, text="ðŸ“‹  Daily summary time (HH:MM):",
                 font=("Segoe UI", 10), bg=BG, fg=FG).pack(side=tk.LEFT)
        time_var = tk.StringVar(value=self.settings.get("summary_time", "09:00"))
        ent = tk.Entry(row, textvariable=time_var, width=7,
                       font=("Segoe UI", 11), justify="center", relief=tk.FLAT,
                       bg=self.T["entry_bg"], fg=FG,
                       highlightthickness=1, highlightbackground="#999")
        ent.pack(side=tk.LEFT, padx=(10, 0), ipady=4)
        ent.focus_set()

        hint = tk.Label(win, text="Popup shows today's tasks at this time each day.",
                        font=("Segoe UI", 9), bg=BG, fg="#888")
        hint.pack(pady=(4, 0))

        def save():
            val = time_var.get().strip()
            try:
                datetime.strptime(val, "%H:%M")
            except ValueError:
                hint.config(text="Invalid â€” use HH:MM  e.g. 08:30", fg="#d13438")
                return
            self.settings["summary_time"] = val
            save_settings(self.settings)
            self._daily_summary_shown = False
            hint.config(text=f"âœ“  Saved â€” summary will show at {val} each day.", fg="#107c10")

        ent.bind("<Return>", lambda e: save())
        win.bind("<Escape>", lambda e: win.destroy())
        bf = tk.Frame(win, bg=BG); bf.pack(pady=10)
        tk.Button(bf, text="Save", command=save, font=("Segoe UI", 10),
                  bg="#0078d4", fg="white", relief=tk.FLAT, padx=12, pady=4
                  ).pack(side=tk.LEFT, padx=(0, 8))
        tk.Button(bf, text="Close", command=win.destroy, font=("Segoe UI", 10),
                  bg="#555", fg="white", relief=tk.FLAT, padx=12, pady=4
                  ).pack(side=tk.LEFT)

    # â”€â”€ Export & Stats â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def _export_csv(self):
        path = filedialog.asksaveasfilename(
            defaultextension=".csv",
            filetypes=[("CSV files", "*.csv")],
            initialfile=f"tasks_{datetime.now().strftime('%Y%m%d')}.csv",
        )
        if not path:
            return
        fields = ["text", "date", "done", "priority", "color", "tags", "project",
                  "due_date", "notes", "pinned", "recurring", "archived",
                  "reminder", "reminder_date", "created"]
        with open(path, "w", newline="", encoding="utf-8") as f:
            w = csv.DictWriter(f, fieldnames=fields)
            w.writeheader()
            for t in self.tasks:
                row = dict(t)
                row["tags"] = " ".join(t.get("tags", []))
                w.writerow({k: row.get(k, "") for k in fields})
        self.status_var.set(f"Exported â†’ {os.path.basename(path)}")

    def _show_stats(self):
        win = tk.Toplevel(self.window)
        win.title("ðŸ“Š  Productivity Stats")
        win.geometry("480x370")
        win.resizable(False, False)
        win.configure(bg=self.T["bg"])
        win.attributes("-topmost", True)
        win.update_idletasks()
        x = self.window.winfo_x() + self.window.winfo_width() // 2 - 240
        y = self.window.winfo_y() + 40
        win.geometry(f"480x370+{x}+{y}")
        today      = datetime.now().strftime("%Y-%m-%d")
        week_start = (datetime.now() - timedelta(days=6)).strftime("%Y-%m-%d")
        done_today  = sum(1 for t in self.tasks if t["done"] and t["date"] == today)
        total_today = sum(1 for t in self.tasks if t["date"] == today)
        done_week   = sum(1 for t in self.tasks if t["done"] and t["date"] >= week_start)
        total_week  = sum(1 for t in self.tasks if t["date"] >= week_start)
        pending_all = sum(1 for t in self.tasks if not t["done"] and not t.get("archived"))
        overdue     = sum(1 for t in self.tasks
                          if not t["done"] and t.get("due_date") and t["due_date"] < today)
        archived    = sum(1 for t in self.tasks if t.get("archived"))
        BG, FG = self.T["bg"], self.T["fg"]
        tk.Label(win, text="ðŸ“Š  Productivity Stats", font=("Segoe UI", 13, "bold"),
                 bg=BG, fg=FG).pack(pady=(14, 8))
        grid = tk.Frame(win, bg=BG); grid.pack(padx=20, pady=4)
        pct = f"{int(done_week / total_week * 100)}%" if total_week else "â€”"
        stats = [
            ("Today Done",    done_today,  "#107c10"), ("Today Total",   total_today, "#0078d4"),
            ("Week Done",     done_week,   "#5c2d91"), ("Week Total",    total_week,  "#004e8c"),
            ("Pending",       pending_all, "#e65100"), ("Overdue",       overdue,     "#c00000"),
            ("Archived",      archived,    "#555555"), ("Week %",        pct,         "#2e7d32"),
        ]
        for i, (lbl, val, col) in enumerate(stats):
            card = tk.Frame(grid, bg=col, padx=14, pady=8)
            card.grid(row=i // 4, column=i % 4, padx=5, pady=5)
            tk.Label(card, text=str(val), font=("Segoe UI", 18, "bold"),
                     bg=col, fg="white").pack()
            tk.Label(card, text=lbl, font=("Segoe UI", 8),
                     bg=col, fg="white").pack()
        # Bar chart â€” last 7 days
        tk.Label(win, text="Completed â€” last 7 days",
                 font=("Segoe UI", 9, "bold"), bg=BG, fg=FG).pack(pady=(10, 2))
        canvas = tk.Canvas(win, width=440, height=85, bg=BG, highlightthickness=0)
        canvas.pack(padx=20)
        days_data = []
        for i in range(6, -1, -1):
            d = (datetime.now() - timedelta(days=i)).strftime("%Y-%m-%d")
            cnt = sum(1 for t in self.tasks if t["done"] and t["date"] == d)
            days_data.append((d[-5:], cnt))
        max_val = max(v for _, v in days_data) or 1
        bar_w, gap = 44, 16
        for idx, (day, val) in enumerate(days_data):
            x0 = gap + idx * (bar_w + gap)
            bh = int(val / max_val * 55) if val else 2
            y0 = 70 - bh
            canvas.create_rectangle(x0, y0, x0 + bar_w, 70, fill="#0078d4", outline="")
            canvas.create_text(x0 + bar_w // 2, 78, text=day, font=("Segoe UI", 7), fill=FG, anchor="n")
            if val:
                canvas.create_text(x0 + bar_w // 2, y0 - 4, text=str(val),
                                   font=("Segoe UI", 8, "bold"), fill=FG)
        tk.Button(win, text="Close", command=win.destroy, font=("Segoe UI", 10),
                  bg="#555", fg="white", relief=tk.FLAT, padx=12, pady=4).pack(pady=10)

    # â”€â”€ Task list actions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def complete_task(self):
        sel = self.listbox.curselection()
        if not sel:
            return
        task = self.displayed_tasks[sel[0]]
        task["done"] = True
        if task.get("recurring", "none") not in ("none", None, ""):
            self._create_recurring(task)
        save_tasks(self.tasks)
        self.refresh_tasks()

    def delete_task(self):
        sel = self.listbox.curselection()
        if not sel:
            return
        self.tasks.remove(self.displayed_tasks[sel[0]])
        save_tasks(self.tasks)
        self.refresh_tasks()

    def archive_task(self):
        sel = self.listbox.curselection()
        if not sel:
            return
        self.displayed_tasks[sel[0]]["archived"] = True
        save_tasks(self.tasks)
        self.refresh_tasks()

    def set_today(self):
        self.date_var.set(datetime.now().strftime("%Y-%m-%d"))
        self.refresh_tasks()

    def show_all(self):
        self.date_var.set("")
        self.refresh_tasks()

    def _drag_start(self, event):
        self._drag_start_index = self.listbox.nearest(event.y)
        self._drag_start_y = event.y

    def _drag_motion(self, event):
        if self._drag_start_index is None:
            return
        current = self.listbox.nearest(event.y)
        if current != self._drag_start_index:
            self.listbox.selection_clear(0, tk.END)
            self.listbox.selection_set(current)
            self.listbox.itemconfig(current, bg="#cce4ff")

    def _drag_release(self, event):
        if self._drag_start_index is None:
            return
        end_index = self.listbox.nearest(event.y)
        if abs(event.y - self._drag_start_y) > 8 and end_index != self._drag_start_index:
            task = self.displayed_tasks[self._drag_start_index]
            target = self.displayed_tasks[end_index]
            si, ti = self.tasks.index(task), self.tasks.index(target)
            self.tasks.insert(ti, self.tasks.pop(si))
            save_tasks(self.tasks)
            self.refresh_tasks()
            self.listbox.selection_set(end_index)
        self._drag_start_index = None
        self._drag_start_y = None

    # â”€â”€ Window visibility â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def hide_window(self):
        if self.window and self.window.winfo_exists():
            self.window.withdraw()

    def show_window(self):
        if self.window and self.window.winfo_exists():
            self.window.deiconify()
            self.window.lift()
            self.window.focus_force()
            self.refresh_tasks()

    def toggle_window(self):
        if self.window and self.window.winfo_exists():
            if self.window.state() == "withdrawn":
                self.window.after(0, self.show_window)
            else:
                self.window.after(0, self.hide_window)

    # â”€â”€ Tray â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def _run_tray(self):
        menu = pystray.Menu(
            pystray.MenuItem("Open / Hide  (Ctrl+Alt+T)",
                             lambda: self.window.after(0, self.toggle_window)),
            pystray.Menu.SEPARATOR,
            pystray.MenuItem("Quit", self.quit_app),
        )
        self.tray_icon = pystray.Icon(
            "todo_tracker", create_icon_image(), "Todo Tracker", menu
        )
        self.tray_icon.run()

    def quit_app(self, *_):
        if self.tray_icon:
            self.tray_icon.stop()
        if self.window:
            self.window.destroy()
        os._exit(0)

    # â”€â”€ Entry point â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def run(self):
        self.create_window()
        threading.Thread(target=self._run_tray, daemon=True).start()
        threading.Thread(target=self._reminder_checker, daemon=True).start()
        keyboard.add_hotkey("ctrl+alt+t", self.toggle_window)
        self.window.mainloop()


if __name__ == "__main__":
    app = TodoApp()
    app.run()


    # â”€â”€ UI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def create_window(self):
        self.window = tk.Tk()
        self.window.title("Todo Tracker")
        self.window.geometry("520x580")
        self.window.resizable(True, True)
        self.window.configure(bg="#f3f3f3")
        self.window.attributes("-topmost", True)

        # Center on screen
        self.window.update_idletasks()
        x = (self.window.winfo_screenwidth() // 2) - 260
        y = (self.window.winfo_screenheight() // 2) - 290
        self.window.geometry(f"520x580+{x}+{y}")

        self.window.bind("<Escape>", lambda e: self.hide_window())
        self.window.protocol("WM_DELETE_WINDOW", self.hide_window)

        self._build_ui()
        self.refresh_tasks()

    def _build_ui(self):
        # â”€â”€ Header â”€â”€
        header = tk.Frame(self.window, bg="#0078d4", pady=10)
        header.pack(fill=tk.X)
