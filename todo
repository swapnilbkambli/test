    # â”€â”€ Task operations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    def refresh_tasks(self):
        if not self.window or not self.window.winfo_exists():
            return
        T = self.T
        date_filter   = self.date_var.get().strip() if hasattr(self, "date_var") else ""
        search_text   = self.search_var.get().strip().lower() if hasattr(self, "search_var") else ""
        tag_filter    = self.tag_filter_var.get().strip().lower() if hasattr(self, "tag_filter_var") else ""
        proj_filter   = self.proj_filter_var.get().strip().lower() if hasattr(self, "proj_filter_var") else ""
        show_archived = self.show_archived_var.get() if hasattr(self, "show_archived_var") else False
        self.listbox.delete(0, tk.END)
        self.displayed_tasks = []
        today = datetime.now().strftime("%Y-%m-%d")
        filtered = []
        for t in self.tasks:
            if t.get("archived") and not show_archived:
                continue
            if date_filter and t["date"] != date_filter:
                continue
            if search_text and search_text not in t["text"].lower() \
                    and search_text not in t.get("notes", "").lower():
                continue
            if tag_filter and tag_filter not in " ".join(t.get("tags", [])).lower():
                continue
            if proj_filter and proj_filter not in t.get("project", "").lower():
                continue
            filtered.append(t)

        def sort_key(t):
            pinned = 0 if t.get("pinned") else 1
            done   = 1 if t.get("done") else 0
            pri    = PRIORITIES.get(t.get("priority", "none"), PRIORITIES["none"])["sort"]
            return (pinned, done, pri)

        for task in sorted(filtered, key=sort_key):
            self.displayed_tasks.append(task)
            status    = "âœ“" if task["done"] else "â—‹"
            icons     = "".join(x for x in [
                "ðŸ“Œ" if task.get("pinned") else "",
                PRIORITIES.get(task.get("priority", "none"), PRIORITIES["none"])["icon"]
                    if task.get("priority", "none") != "none" else "",
                "ðŸ”" if task.get("recurring", "none") not in ("none", None, "") else "",
                "ðŸ“" if task.get("notes") else "",
                "ðŸ“¦" if task.get("archived") else "",
            ] if x)
            reminder = task.get("reminder", "")
            rem_date = task.get("reminder_date", task["date"])
            if reminder and not task["done"]:
                rem_str = f" â°{rem_date} {reminder}" if rem_date != task["date"] else f" â°{reminder}"
            else:
                rem_str = ""
            tags_str = (" [" + " ".join("#" + tg for tg in task.get("tags", [])) + "]") \
                if task.get("tags") else ""
            proj_str = (f" ðŸ“{task['project']}") if task.get("project") else ""
            due_str  = (f" ðŸ“…{task['due_date']}") if task.get("due_date") else ""
            prefix   = f" {icons}" if icons else ""
            line = f"  {status}{prefix}  [{task['date']}]{due_str}{rem_str}{proj_str}{tags_str}  {task['text']}"
            self.listbox.insert(tk.END, line)

            is_overdue = (not task["done"] and task.get("due_date") and task["due_date"] < today)
            if task.get("archived"):
                self.listbox.itemconfig(tk.END, fg="#888888", bg=T["done_bg"])
            elif task["done"]:
                self.listbox.itemconfig(tk.END, fg=T["done_fg"], bg=T["done_bg"])
            elif is_overdue:
                self.listbox.itemconfig(tk.END, fg=T["overdue"],
                                        bg="#fff0f0" if not self._dark_mode else "#3a1a1a")
            else:
                if self._dark_mode:
                    c_bg, c_fg = T["pin_bg"] if task.get("pinned") else T["row_bg"], T["row_fg"]
                else:
                    c = COLORS.get(task.get("color", "default"), COLORS["default"])
                    c_bg = T["pin_bg"] if task.get("pinned") else c["bg"]
                    c_fg = c["fg"]
                self.listbox.itemconfig(tk.END, fg=c_fg, bg=c_bg)

        pending = sum(1 for t in self.tasks if not t["done"] and not t.get("archived"))
        self.status_var.set(
            f"{len(filtered)} shown  |  {pending} pending  |  Ctrl+Alt+T  |  DelÂ·SpaceÂ·EÂ·NÂ·P"
        )
        self._update_tray_badge(pending)

    def add_task(self):
        text = self.task_var.get().strip()
        if not text:
            return
        date = self.date_var.get().strip() or datetime.now().strftime("%Y-%m-%d")
        reminder = self.reminder_var.get().strip()
        if reminder in ("HH:MM", ""):
            reminder = ""
        else:
            try:
                datetime.strptime(reminder, "%H:%M")
            except ValueError:
                reminder = ""
        raw_tags = self.tags_var.get().strip()
        tags = [t.lstrip("#").strip() for t in raw_tags.replace(",", " ").split() if t.strip()]
        due = self.due_var.get().strip()
        if due:
            try:
                datetime.strptime(due, "%Y-%m-%d")
            except ValueError:
                due = ""
        self.tasks.append({
            "text":          text,
            "date":          date,
            "done":          False,
            "color":         "default",
            "priority":      self.priority_var.get(),
            "reminder":      reminder,
            "reminder_date": date if reminder else "",
            "reminded":      False,
            "tags":          tags,
            "project":       self.project_var.get().strip(),
            "due_date":      due,
            "notes":         self.notes_var.get().strip(),
            "pinned":        self.pin_var.get(),
            "recurring":     self.recur_var.get(),
            "archived":      False,
            "created":       datetime.now().isoformat(),
        })
        save_tasks(self.tasks)
        for v in (self.task_var, self.reminder_var, self.tags_var,
                  self.notes_var, self.due_var, self.project_var):
            v.set("")
        self.priority_var.set("none")
        self.recur_var.set("none")
        self.pin_var.set(False)
        self.refresh_tasks()

    def _on_double_click(self, event):
        sel = self.listbox.curselection()
        if not sel:
            return
        task = self.displayed_tasks[sel[0]]
        task["done"] = not task["done"]
        if task["done"] and task.get("recurring", "none") not in ("none", None, ""):
            self._create_recurring(task)
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _create_recurring(self, task):
        delta_map = {"daily": 1, "weekly": 7, "monthly": 30}
        days = delta_map.get(task.get("recurring", "none"), 0)
        if not days:
            return
        try:
            base = datetime.strptime(task["date"], "%Y-%m-%d")
        except ValueError:
            base = datetime.now()
        next_date = (base + timedelta(days=days)).strftime("%Y-%m-%d")
        new_task = {k: v for k, v in task.items()}
        new_task["done"]         = False
        new_task["date"]         = next_date
        new_task["reminded"]     = False
        new_task["created"]      = datetime.now().isoformat()
        if task.get("reminder"):
            new_task["reminder_date"] = next_date
        self.tasks.append(new_task)

    def _on_right_click(self, event):
        index = self.listbox.nearest(event.y)
        if index < 0 or index >= len(self.displayed_tasks):
            return
        self.listbox.selection_clear(0, tk.END)
        self.listbox.selection_set(index)
        task = self.displayed_tasks[index]
        menu = tk.Menu(self.window, tearoff=0)
        menu.add_command(label="Mark Incomplete" if task["done"] else "âœ“  Mark Complete",
                         command=lambda: self._toggle_done(index))
        menu.add_command(label="âœ  Edit Task  [E]", command=lambda: self._edit_task(index))
        menu.add_command(label="ðŸ“  Notes  [N]",    command=lambda: self._edit_notes(index))
        menu.add_separator()
        pri_menu = tk.Menu(menu, tearoff=0)
        for k, v in PRIORITIES.items():
            pri_menu.add_command(label=f"{v['icon']}  {v['label']}",
                                 command=lambda kk=k, ii=index: self._set_priority(ii, kk))
        menu.add_cascade(label="ðŸŽ¯  Set Priority", menu=pri_menu)
        color_menu = tk.Menu(menu, tearoff=0)
        for clabel, ckey in [
            ("â¬œ  Default", "default"), ("ðŸ”´  Red", "red"), ("ðŸŸ   Orange", "orange"),
            ("ðŸŸ¡  Yellow", "yellow"),  ("ðŸŸ¢  Green", "green"),
            ("ðŸ”µ  Blue", "blue"),      ("ðŸŸ£  Purple", "purple"),
        ]:
            color_menu.add_command(label=clabel,
                                   command=lambda k=ckey, i=index: self._set_color(i, k))
        menu.add_cascade(label="ðŸŽ¨  Set Color", menu=color_menu)
        menu.add_command(label="â°  Set Reminder",
                         command=lambda: self._set_reminder_dialog(index))
        menu.add_separator()
        menu.add_command(label="ðŸ“Œ  Unpin  [P]" if task.get("pinned") else "ðŸ“Œ  Pin to Top  [P]",
                         command=lambda: self._toggle_pin(index))
        menu.add_command(label="ðŸ“¦  Unarchive" if task.get("archived") else "ðŸ“¦  Archive",
                         command=lambda: self._toggle_archive(index))
        menu.add_separator()
        menu.add_command(label="ðŸ—‘  Delete", command=self.delete_task)
        menu.tk_popup(event.x_root, event.y_root)

    def _toggle_done(self, index):
        task = self.displayed_tasks[index]
        task["done"] = not task["done"]
        if task["done"] and task.get("recurring", "none") not in ("none", None, ""):
            self._create_recurring(task)
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _toggle_pin(self, index):
        self.displayed_tasks[index]["pinned"] = not self.displayed_tasks[index].get("pinned", False)
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _toggle_archive(self, index):
        self.displayed_tasks[index]["archived"] = not self.displayed_tasks[index].get("archived", False)
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _edit_selected(self):
        sel = self.listbox.curselection()
        if sel:
            self._edit_task(sel[0])

    def _notes_selected(self):
        sel = self.listbox.curselection()
        if sel:
            self._edit_notes(sel[0])

    def _pin_selected(self):
        sel = self.listbox.curselection()
        if sel:
            self._toggle_pin(sel[0])

    def _set_priority(self, index, key):
        self.displayed_tasks[index]["priority"] = key
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _set_color(self, index, color_key):
        self.displayed_tasks[index]["color"] = color_key
        save_tasks(self.tasks)
        self.refresh_tasks()

    def _edit_task(self, index):
        task = self.displayed_tasks[index]
        win = tk.Toplevel(self.window)
        win.title("âœ  Edit Task")
        win.geometry("440x140")
        win.resizable(False, False)
        win.configure(bg=self.T["bg"])
        win.attributes("-topmost", True)
        win.grab_set()
        win.update_idletasks()
        x = self.window.winfo_x() + self.window.winfo_width() // 2 - 220
        y = self.window.winfo_y() + self.window.winfo_height() // 2 - 70
        win.geometry(f"440x140+{x}+{y}")
        tk.Label(win, text="Task text:", font=("Segoe UI", 10),
                 bg=self.T["bg"], fg=self.T["fg"]).pack(anchor=tk.W, padx=12, pady=(12, 4))
        var = tk.StringVar(value=task["text"])
        ent = tk.Entry(win, textvariable=var, font=("Segoe UI", 10),
                       bg=self.T["entry_bg"], fg=self.T["fg"],
                       relief=tk.FLAT, highlightthickness=1, highlightbackground="#999")
        ent.pack(fill=tk.X, padx=12, ipady=4)
        ent.select_range(0, tk.END)
        ent.focus_set()
        def save(event=None):
            v = var.get().strip()
            if v:
                task["text"] = v
                save_tasks(self.tasks)
                self.refresh_tasks()
            win.destroy()
        ent.bind("<Return>", save)
        win.bind("<Escape>", lambda e: win.destroy())
        bf = tk.Frame(win, bg=self.T["bg"])
        bf.pack(fill=tk.X, padx=12, pady=8)
        tk.Button(bf, text="Save", command=save, font=("Segoe UI", 10),
                  bg="#0078d4", fg="white", relief=tk.FLAT, padx=10, pady=3
                  ).pack(side=tk.LEFT, padx=(0, 6))
        tk.Button(bf, text="Cancel", command=win.destroy, font=("Segoe UI", 10),
                  bg="#555", fg="white", relief=tk.FLAT, padx=10, pady=3).pack(side=tk.LEFT)

