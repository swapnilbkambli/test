def load_tasks():
    if os.path.exists(TASKS_FILE):
        with open(TASKS_FILE, "r") as f:
            return json.load(f)
    return []


def save_tasks(tasks):
    with open(TASKS_FILE, "w") as f:
        json.dump(tasks, f, indent=2)


def auto_backup():
    if not os.path.exists(TASKS_FILE):
        return
    os.makedirs(BACKUP_DIR, exist_ok=True)
    stamp = datetime.now().strftime("%Y-%m-%d")
    dest = os.path.join(BACKUP_DIR, f"tasks_{stamp}.json")
    if not os.path.exists(dest):
        shutil.copy2(TASKS_FILE, dest)
    backups = sorted(f for f in os.listdir(BACKUP_DIR) if f.endswith(".json"))
    for old in backups[:-30]:
        os.remove(os.path.join(BACKUP_DIR, old))


def create_icon_image(badge=0):
    img = Image.new("RGBA", (64, 64), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)
    draw.rectangle([0, 0, 63, 63], fill=(0, 120, 212))
    draw.rectangle([8, 12, 56, 52], outline="white", width=3)
    draw.line([16, 24, 24, 34], fill="white", width=3)
    draw.line([24, 34, 48, 16], fill="white", width=3)
    draw.line([16, 40, 48, 40], fill="white", width=2)
    if badge > 0:
        draw.ellipse([36, 0, 63, 27], fill=(220, 50, 50))
        draw.text((50, 14), str(min(badge, 99)), fill="white", anchor="mm")
    return img


