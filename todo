    @property
    def T(self):
        return DARK if self._dark_mode else LIGHT

    def toggle_dark_mode(self):
        self._dark_mode = not self._dark_mode
        for w in self.window.winfo_children():
            w.destroy()
        self._build_ui()
        self.refresh_tasks()

